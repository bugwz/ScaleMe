            "value" : "Only values explicitly provided by selected devices"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo valores proporcionados explícitamente por los dispositivos seleccionados"
          }
        },
        "fr" : {
