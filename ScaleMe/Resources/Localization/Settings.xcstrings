    "将把文件中的 %lld 条记录与本机记录合并，重复记录不会重复保存。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Einträge aus der Datei werden mit den lokalen Einträgen zusammengeführt. Duplikate werden nicht erneut gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld records from the file will be merged with local records. Duplicates will not be saved again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se combinarán %lld registros del archivo con los registros locales. Los duplicados no se guardarán de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld relevés du fichier seront fusionnés avec les relevés locaux. Les doublons ne seront pas enregistrés à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル内の%lld件の記録をローカル記録と統合します。重複する記録は再保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일의 기록 %lld개를 로컬 기록과 병합합니다. 중복 기록은 다시 저장하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld registos do ficheiro serão combinados com os registos locais. Os duplicados não serão guardados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи из файла (%lld) будут объединены с локальными. Дубликаты не будут сохранены повторно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将把文件中的 %lld 条记录与本机记录合并，重复记录不会重复保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會將檔案中的 %lld 筆記錄與本機記錄合併，重複記錄不會再次儲存。"
          }
        }
      }
    },
