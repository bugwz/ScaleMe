    "横轴从首条数据延伸至末条数据": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die horizontale Achse reicht vom ersten bis zum letzten Datenpunkt"}},"en":{"stringUnit":{"state":"translated","value":"The horizontal axis runs from the first to the last data point"}},"es":{"stringUnit":{"state":"translated","value":"El eje horizontal va desde el primer dato hasta el último"}},"fr":{"stringUnit":{"state":"translated","value":"L'axe horizontal va de la première à la dernière donnée"}},"ja":{"stringUnit":{"state":"translated","value":"横軸を最初から最後のデータまで表示"}},"ko":{"stringUnit":{"state":"translated","value":"가로축을 첫 데이터부터 마지막 데이터까지 표시"}},"pt":{"stringUnit":{"state":"translated","value":"O eixo horizontal vai do primeiro ao último ponto de dados"}},"ru":{"stringUnit":{"state":"translated","value":"Горизонтальная ось идет от первой до последней точки данных"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"横轴从首条数据延伸至末条数据"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"橫軸從第一筆資料延伸至最後一筆資料"}}}},
    "横轴覆盖所选区间，包括无数据时段": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die horizontale Achse deckt den gewählten Zeitraum einschließlich Zeiten ohne Daten ab"}},"en":{"stringUnit":{"state":"translated","value":"The horizontal axis covers the selected range, including periods without data"}},"es":{"stringUnit":{"state":"translated","value":"El eje horizontal cubre el intervalo seleccionado, incluidos los periodos sin datos"}},"fr":{"stringUnit":{"state":"translated","value":"L'axe horizontal couvre la période sélectionnée, y compris les périodes sans données"}},"ja":{"stringUnit":{"state":"translated","value":"データがない期間を含め、選択した範囲全体を横軸に表示"}},"ko":{"stringUnit":{"state":"translated","value":"데이터가 없는 기간을 포함해 선택한 전체 구간을 가로축에 표시"}},"pt":{"stringUnit":{"state":"translated","value":"O eixo horizontal cobre o intervalo selecionado, incluindo períodos sem dados"}},"ru":{"stringUnit":{"state":"translated","value":"Горизонтальная ось охватывает выбранный период, включая интервалы без данных"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"横轴覆盖所选区间，包括无数据时段"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"橫軸涵蓋所選區間，包括無資料時段"}}}},
