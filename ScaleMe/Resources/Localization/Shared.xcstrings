    "隐私政策": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Datenschutzrichtlinie"}},"en":{"stringUnit":{"state":"translated","value":"Privacy Policy"}},"es":{"stringUnit":{"state":"translated","value":"Política de privacidad"}},"fr":{"stringUnit":{"state":"translated","value":"Politique de confidentialité"}},"ja":{"stringUnit":{"state":"translated","value":"プライバシーポリシー"}},"ko":{"stringUnit":{"state":"translated","value":"개인정보 처리방침"}},"pt":{"stringUnit":{"state":"translated","value":"Política de privacidade"}},"ru":{"stringUnit":{"state":"translated","value":"Политика конфиденциальности"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私政策"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"隱私權政策"}}}},
    "青少年": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Jugendlicher"}},"en":{"stringUnit":{"state":"translated","value":"Teenager"}},"es":{"stringUnit":{"state":"translated","value":"Adolescente"}},"fr":{"stringUnit":{"state":"translated","value":"Adolescent"}},"ja":{"stringUnit":{"state":"translated","value":"青少年"}},"ko":{"stringUnit":{"state":"translated","value":"청소년"}},"pt":{"stringUnit":{"state":"translated","value":"Adolescente"}},"ru":{"stringUnit":{"state":"translated","value":"Подросток"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"青少年"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"青少年"}}}},
    "青少年女儿": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Tochter im Teenageralter"}},"en":{"stringUnit":{"state":"translated","value":"Teenage daughter"}},"es":{"stringUnit":{"state":"translated","value":"Hija adolescente"}},"fr":{"stringUnit":{"state":"translated","value":"Fille adolescente"}},"ja":{"stringUnit":{"state":"translated","value":"10代の娘"}},"ko":{"stringUnit":{"state":"translated","value":"십 대 딸"}},"pt":{"stringUnit":{"state":"translated","value":"Filha adolescente"}},"ru":{"stringUnit":{"state":"translated","value":"Дочь-подросток"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"青少年女儿"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"青少年女兒"}}}},
    "首页": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Start"}},"en":{"stringUnit":{"state":"translated","value":"Home"}},"es":{"stringUnit":{"state":"translated","value":"Inicio"}},"fr":{"stringUnit":{"state":"translated","value":"Accueil"}},"ja":{"stringUnit":{"state":"translated","value":"ホーム"}},"ko":{"stringUnit":{"state":"translated","value":"홈"}},"pt":{"stringUnit":{"state":"translated","value":"Início"}},"ru":{"stringUnit":{"state":"translated","value":"Главная"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首页"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"首頁"}}}},
    "骨量": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Knochenmasse"}},"en":{"stringUnit":{"state":"translated","value":"Bone mass"}},"es":{"stringUnit":{"state":"translated","value":"Masa ósea"}},"fr":{"stringUnit":{"state":"translated","value":"Masse osseuse"}},"ja":{"stringUnit":{"state":"translated","value":"骨量"}},"ko":{"stringUnit":{"state":"translated","value":"골량"}},"pt":{"stringUnit":{"state":"translated","value":"Massa óssea"}},"ru":{"stringUnit":{"state":"translated","value":"Костная масса"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"骨量"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"骨量"}}}},
    "骨量占比": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Knochenanteil"}},"en":{"stringUnit":{"state":"translated","value":"Bone %"}},"es":{"stringUnit":{"state":"translated","value":"Porcentaje óseo"}},"fr":{"stringUnit":{"state":"translated","value":"Taux osseux"}},"ja":{"stringUnit":{"state":"translated","value":"骨量率"}},"ko":{"stringUnit":{"state":"translated","value":"골량 비율"}},"pt":{"stringUnit":{"state":"translated","value":"Percentagem óssea"}},"ru":{"stringUnit":{"state":"translated","value":"Процент костной массы"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"骨量占比"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"骨量比例"}}}},
    "身体成分仅供趋势参考，不用于诊断或治疗。在作出医疗决定前，请咨询医生。": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"身体成分仅供趋势参考，不用于诊断或治疗。在作出医疗决定前，请咨询医生。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體組成僅供趨勢參考，不用於診斷或治療。在作出醫療決定前，請諮詢醫生。"}},"en":{"stringUnit":{"state":"translated","value":"Body composition is for tracking trends, not diagnosis or treatment. Consult a doctor before making medical decisions."}},"de":{"stringUnit":{"state":"translated","value":"Die Körperzusammensetzung dient der Trendbeobachtung, nicht der Diagnose oder Behandlung. Holen Sie vor medizinischen Entscheidungen ärztlichen Rat ein."}},"es":{"stringUnit":{"state":"translated","value":"La composición corporal sirve para observar tendencias, no para diagnosticar ni tratar. Consulte a un médico antes de tomar decisiones médicas."}},"fr":{"stringUnit":{"state":"translated","value":"La composition corporelle sert à suivre les tendances, pas à diagnostiquer ni à traiter. Consultez un médecin avant toute décision médicale."}},"ja":{"stringUnit":{"state":"translated","value":"体組成は傾向を把握するための参考情報であり、診断や治療には使用できません。医療上の判断をする前に医師に相談してください。"}},"ko":{"stringUnit":{"state":"translated","value":"체성분은 추세 참고용이며 진단이나 치료에 사용하지 않습니다. 의학적 결정을 내리기 전에 의사와 상담하세요."}},"pt":{"stringUnit":{"state":"translated","value":"A composição corporal serve para acompanhar tendências, não para diagnóstico ou tratamento. Consulte um médico antes de tomar decisões médicas."}},"ru":{"stringUnit":{"state":"translated","value":"Состав тела служит для наблюдения за тенденциями, а не для диагностики или лечения. Перед медицинскими решениями проконсультируйтесь с врачом."}}}},
    "测量需要连接兼容的蓝牙体重秤。手机本身不能测量体重或身体成分。": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"测量需要连接兼容的蓝牙体重秤。手机本身不能测量体重或身体成分。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測量需要連接相容的藍牙體重計。手機本身不能測量體重或身體組成。"}},"en":{"stringUnit":{"state":"translated","value":"Measurement requires a compatible Bluetooth scale. The phone itself cannot measure weight or body composition."}},"de":{"stringUnit":{"state":"translated","value":"Für Messungen ist eine kompatible Bluetooth-Waage erforderlich. Das Telefon selbst kann weder Gewicht noch Körperzusammensetzung messen."}},"es":{"stringUnit":{"state":"translated","value":"La medición requiere una báscula Bluetooth compatible. El teléfono no puede medir el peso ni la composición corporal por sí solo."}},"fr":{"stringUnit":{"state":"translated","value":"La mesure nécessite une balance Bluetooth compatible. Le téléphone seul ne peut mesurer ni le poids ni la composition corporelle."}},"ja":{"stringUnit":{"state":"translated","value":"測定には対応するBluetooth体重計の接続が必要です。スマートフォン単体では体重や体組成を測定できません。"}},"ko":{"stringUnit":{"state":"translated","value":"측정하려면 호환되는 Bluetooth 체중계가 필요합니다. 휴대전화 자체로는 체중이나 체성분을 측정할 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A medição requer uma balança Bluetooth compatível. O telemóvel, por si só, não mede o peso nem a composição corporal."}},"ru":{"stringUnit":{"state":"translated","value":"Для измерения нужны совместимые Bluetooth-весы. Сам телефон не измеряет вес или состав тела."}}}},
    "计算值": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"计算值"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"計算值"}},"en":{"stringUnit":{"state":"translated","value":"Calculated"}},"de":{"stringUnit":{"state":"translated","value":"Berechnet"}},"es":{"stringUnit":{"state":"translated","value":"Calculado"}},"fr":{"stringUnit":{"state":"translated","value":"Calculé"}},"ja":{"stringUnit":{"state":"translated","value":"計算値"}},"ko":{"stringUnit":{"state":"translated","value":"계산값"}},"pt":{"stringUnit":{"state":"translated","value":"Calculado"}},"ru":{"stringUnit":{"state":"translated","value":"Расчёт"}}}},
    "BMI＝体重（kg）÷身高（m）的平方；质量＝体重×比例，比例＝质量÷体重。蛋白质量为去脂质量减去水分量和骨量的残差估算，不能替代检测。缺少输入时不计算，结果依赖原始数据的准确性。": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"BMI＝体重（kg）÷身高（m）的平方；质量＝体重×比例，比例＝质量÷体重。蛋白质量为去脂质量减去水分量和骨量的残差估算，不能替代检测。缺少输入时不计算，结果依赖原始数据的准确性。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BMI＝體重（kg）÷身高（m）的平方；質量＝體重×比例，比例＝質量÷體重。蛋白質量為去脂質量減去水分量和骨量的殘差估算，不能替代檢測。缺少輸入時不計算，結果依賴原始資料的準確性。"}},"en":{"stringUnit":{"state":"translated","value":"BMI = weight (kg) / height (m) squared. Mass = weight × fraction; fraction = mass / weight. Protein mass is a residual estimate of fat-free mass minus water and bone mass, not a test result. Missing inputs are not filled in. Results depend on input accuracy."}},"de":{"stringUnit":{"state":"translated","value":"BMI = Gewicht (kg) / Körpergröße (m) zum Quadrat. Masse = Gewicht × Anteil; Anteil = Masse / Gewicht. Proteinmasse ist eine Restschätzung aus fettfreier Masse abzüglich Wasser- und Knochenmasse, kein Testergebnis. Fehlende Eingaben werden nicht ergänzt. Ergebnisse hängen von der Genauigkeit der Eingaben ab."}},"es":{"stringUnit":{"state":"translated","value":"IMC = peso (kg) / altura (m) al cuadrado. Masa = peso × fracción; fracción = masa / peso. La masa proteica es una estimación residual de la masa libre de grasa menos agua y hueso, no un análisis. No se completan los datos ausentes. El resultado depende de la precisión de los datos."}},"fr":{"stringUnit":{"state":"translated","value":"IMC = poids (kg) / taille (m) au carré. Masse = poids × fraction ; fraction = masse / poids. La masse protéique est une estimation résiduelle de la masse maigre moins les masses hydrique et osseuse, pas un résultat de test. Les données manquantes ne sont pas complétées. Les résultats dépendent de leur précision."}},"ja":{"stringUnit":{"state":"translated","value":"BMI＝体重（kg）÷身長（m）の2乗。質量＝体重×割合、割合＝質量÷体重。タンパク質量は除脂肪量から水分量と骨量を引いた残差の推定で、検査結果ではありません。入力が不足する場合は計算しません。結果は入力の精度に依存します。"}},"ko":{"stringUnit":{"state":"translated","value":"BMI＝체중(kg)÷키(m)의 제곱. 질량＝체중×비율, 비율＝질량÷체중. 단백질량은 제지방량에서 수분량과 골량을 뺀 잔차 추정치이며 검사 결과가 아닙니다. 입력이 없으면 계산하지 않습니다. 결과는 입력의 정확도에 따라 달라집니다."}},"pt":{"stringUnit":{"state":"translated","value":"IMC = peso (kg) / altura (m) ao quadrado. Massa = peso × fração; fração = massa / peso. A massa proteica é uma estimativa residual da massa isenta de gordura menos água e osso, não um resultado de análise. Os dados em falta não são preenchidos. Os resultados dependem da precisão dos dados."}},"ru":{"stringUnit":{"state":"translated","value":"ИМТ = вес (кг) / рост (м) в квадрате. Масса = вес × доля; доля = масса / вес. Масса белка — остаточная оценка безжировой массы за вычетом воды и костной массы, а не результат анализа. Пропущенные данные не восполняются. Результат зависит от точности исходных данных."}}}},
    "开启共享或获取数据时，分别请求所需权限。读取权限状态请在“健康”应用中查看；没有可读取记录不代表授权失败。": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"开启共享或获取数据时，分别请求所需权限。读取权限状态请在“健康”应用中查看；没有可读取记录不代表授权失败。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟共享或取得資料時，分別請求所需權限。讀取權限狀態請在「健康」App 中查看；沒有可讀取記錄不代表授權失敗。"}},"en":{"stringUnit":{"state":"translated","value":"Sharing and importing request their own permissions. Check read permissions in Health; no readable records does not mean authorization failed."}},"de":{"stringUnit":{"state":"translated","value":"Teilen und Importieren fordern jeweils eigene Berechtigungen an. Leserechte prüfen Sie in Health; keine lesbaren Einträge bedeuten nicht, dass die Autorisierung fehlgeschlagen ist."}},"es":{"stringUnit":{"state":"translated","value":"Compartir e importar solicitan sus propios permisos. Consulte los permisos de lectura en Salud; no encontrar registros no significa que la autorización haya fallado."}},"fr":{"stringUnit":{"state":"translated","value":"Le partage et l’importation demandent leurs propres autorisations. Vérifiez les droits de lecture dans Santé ; l’absence de données ne signifie pas un échec d’autorisation."}},"ja":{"stringUnit":{"state":"translated","value":"共有と読み込みでは、それぞれ必要な権限を要求します。読み取り権限はヘルスケアで確認してください。読み取れる記録がない場合でも、許可の失敗とは限りません。"}},"ko":{"stringUnit":{"state":"translated","value":"공유와 가져오기는 각각 필요한 권한을 요청합니다. 읽기 권한은 건강 앱에서 확인하세요. 읽을 수 있는 기록이 없다고 해서 권한 요청이 실패한 것은 아닙니다."}},"pt":{"stringUnit":{"state":"translated","value":"A partilha e a importação pedem as respetivas permissões. Consulte as permissões de leitura na Saúde; a ausência de registos não significa que a autorização falhou."}},"ru":{"stringUnit":{"state":"translated","value":"Для передачи и импорта запрашиваются отдельные разрешения. Права чтения проверяйте в «Здоровье»; отсутствие записей не означает сбой авторизации."}}}}
  },
  "version": "1.0"
}
