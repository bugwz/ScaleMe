    "无数据" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Daten"}},"en":{"stringUnit":{"state":"translated","value":"No data"}},"es":{"stringUnit":{"state":"translated","value":"Sin datos"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune donnée"}},"ja":{"stringUnit":{"state":"translated","value":"データなし"}},"ko":{"stringUnit":{"state":"translated","value":"데이터 없음"}},"pt":{"stringUnit":{"state":"translated","value":"Sem dados"}},"ru":{"stringUnit":{"state":"translated","value":"Нет данных"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无数据"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無資料"}}}},
    "数据异常" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ungültige Daten"}},"en":{"stringUnit":{"state":"translated","value":"Invalid data"}},"es":{"stringUnit":{"state":"translated","value":"Datos no válidos"}},"fr":{"stringUnit":{"state":"translated","value":"Données invalides"}},"ja":{"stringUnit":{"state":"translated","value":"無効なデータ"}},"ko":{"stringUnit":{"state":"translated","value":"잘못된 데이터"}},"pt":{"stringUnit":{"state":"translated","value":"Dados inválidos"}},"ru":{"stringUnit":{"state":"translated","value":"Некорректные данные"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据异常"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"資料異常"}}}},
    "儿童 BMI 标准 · WHO" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"BMI-Standards für Kinder · WHO"}},"en":{"stringUnit":{"state":"translated","value":"Child BMI standards · WHO"}},"es":{"stringUnit":{"state":"translated","value":"Estándares infantiles de IMC · OMS"}},"fr":{"stringUnit":{"state":"translated","value":"Normes d’IMC de l’enfant · OMS"}},"ja":{"stringUnit":{"state":"translated","value":"小児 BMI 基準 · WHO"}},"ko":{"stringUnit":{"state":"translated","value":"소아 BMI 기준 · WHO"}},"pt":{"stringUnit":{"state":"translated","value":"Padrões de IMC infantil · OMS"}},"ru":{"stringUnit":{"state":"translated","value":"Нормы ИМТ детей · ВОЗ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"儿童 BMI 标准 · WHO"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"兒童 BMI 標準 · WHO"}}}},
    "青少年 BMI 参考 · WHO" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"BMI-Referenz für Jugendliche · WHO"}},"en":{"stringUnit":{"state":"translated","value":"Adolescent BMI reference · WHO"}},"es":{"stringUnit":{"state":"translated","value":"Referencia adolescente de IMC · OMS"}},"fr":{"stringUnit":{"state":"translated","value":"Référence d’IMC adolescent · OMS"}},"ja":{"stringUnit":{"state":"translated","value":"青少年 BMI 参考 · WHO"}},"ko":{"stringUnit":{"state":"translated","value":"청소년 BMI 참고 · WHO"}},"pt":{"stringUnit":{"state":"translated","value":"Referência de IMC adolescente · OMS"}},"ru":{"stringUnit":{"state":"translated","value":"ИМТ подростков · ВОЗ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"青少年 BMI 参考 · WHO"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"青少年 BMI 參考 · WHO"}}}},
    "分年龄基础代谢 · FAO" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Altersabhängiger Grundumsatz · FAO"}},"en":{"stringUnit":{"state":"translated","value":"Age-specific BMR · FAO"}},"es":{"stringUnit":{"state":"translated","value":"Metabolismo basal por edad · FAO"}},"fr":{"stringUnit":{"state":"translated","value":"Métabolisme basal selon l’âge · FAO"}},"ja":{"stringUnit":{"state":"translated","value":"年齢別基礎代謝 · FAO"}},"ko":{"stringUnit":{"state":"translated","value":"연령별 기초대사 · FAO"}},"pt":{"stringUnit":{"state":"translated","value":"Metabolismo basal por idade · FAO"}},"ru":{"stringUnit":{"state":"translated","value":"Базальный обмен по возрасту · ФАО"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分年龄基础代谢 · FAO"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"分年齡基礎代謝 · FAO"}}}},
    "严重偏低" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Stark niedrig"}},"en":{"stringUnit":{"state":"translated","value":"Severely low"}},"es":{"stringUnit":{"state":"translated","value":"Muy bajo"}},"fr":{"stringUnit":{"state":"translated","value":"Très faible"}},"ja":{"stringUnit":{"state":"translated","value":"著しく低い"}},"ko":{"stringUnit":{"state":"translated","value":"매우 낮음"}},"pt":{"stringUnit":{"state":"translated","value":"Muito baixo"}},"ru":{"stringUnit":{"state":"translated","value":"Очень низкий"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"严重偏低"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"嚴重偏低"}}}},
    "超重风险" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Übergewichtsrisiko"}},"en":{"stringUnit":{"state":"translated","value":"Risk of overweight"}},"es":{"stringUnit":{"state":"translated","value":"Riesgo de sobrepeso"}},"fr":{"stringUnit":{"state":"translated","value":"Risque de surpoids"}},"ja":{"stringUnit":{"state":"translated","value":"過体重リスク"}},"ko":{"stringUnit":{"state":"translated","value":"과체중 위험"}},"pt":{"stringUnit":{"state":"translated","value":"Risco de excesso de peso"}},"ru":{"stringUnit":{"state":"translated","value":"Риск избыточного веса"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"超重风险"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"過重風險"}}}},
    "BMI 是体重与身高平方的比值，用于描述体重相对身高的水平，不能直接区分脂肪和肌肉。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"BMI is weight divided by height squared. It describes weight relative to height and does not distinguish fat from muscle."}},"de":{"stringUnit":{"state":"translated","value":"Der BMI ist Gewicht geteilt durch Körpergröße zum Quadrat. Er beschreibt das Gewicht relativ zur Größe und unterscheidet nicht zwischen Fett und Muskeln."}},"es":{"stringUnit":{"state":"translated","value":"El IMC es el peso dividido entre la altura al cuadrado. Describe el peso relativo a la altura, sin distinguir grasa y músculo."}},"fr":{"stringUnit":{"state":"translated","value":"L’IMC est le poids divisé par la taille au carré. Il décrit le poids relatif à la taille sans distinguer graisse et muscle."}},"ja":{"stringUnit":{"state":"translated","value":"BMIは体重を身長の二乗で割った値です。身長に対する体重を表し、脂肪と筋肉を区別できません。"}},"ko":{"stringUnit":{"state":"translated","value":"BMI는 체중을 키의 제곱으로 나눈 값입니다. 키에 대한 체중 수준을 나타내며 지방과 근육을 구분하지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O IMC é o peso dividido pela altura ao quadrado. Descreve o peso relativo à altura sem distinguir gordura de músculo."}},"ru":{"stringUnit":{"state":"translated","value":"ИМТ — масса тела, делённая на квадрат роста. Он описывает вес относительно роста, не различая жир и мышцы."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BMI 是體重與身高平方的比值，用於描述體重相對身高的水平，不能直接區分脂肪和肌肉。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BMI 是体重与身高平方的比值，用于描述体重相对身高的水平，不能直接区分脂肪和肌肉。"}}}},
    "体脂率是脂肪占体重的比例；脂肪量是对应的质量。质量范围随体重变化，状态按同次体脂率判断。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Body fat percentage is the proportion of weight that is fat; fat mass is its mass. Mass ranges depend on weight; status follows the body fat percentage from the same measurement."}},"de":{"stringUnit":{"state":"translated","value":"Körperfettanteil ist der Fettanteil am Gewicht; Fettmasse ist die entsprechende Masse. Massenbereiche hängen vom Gewicht ab; der Status folgt dem Fettanteil derselben Messung."}},"es":{"stringUnit":{"state":"translated","value":"El porcentaje de grasa es la proporción del peso que es grasa; la masa grasa es su masa. Los rangos de masa dependen del peso; el estado sigue el porcentaje de la misma medición."}},"fr":{"stringUnit":{"state":"translated","value":"Le taux de graisse est la part du poids constituée de graisse ; la masse grasse en est la masse. Les plages de masse dépendent du poids ; le statut suit le taux de la même mesure."}},"ja":{"stringUnit":{"state":"translated","value":"体脂肪率は体重に占める脂肪の割合、脂肪量はその質量です。質量の範囲は体重で変わり、状態は同じ測定の体脂肪率で判定します。"}},"ko":{"stringUnit":{"state":"translated","value":"체지방률은 체중 중 지방의 비율이며 지방량은 해당 질량입니다. 질량 범위는 체중에 따라 달라지며 상태는 같은 측정의 체지방률로 판단합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A porcentagem de gordura é a fração do peso composta por gordura; a massa gorda é sua massa. As faixas de massa dependem do peso; o estado segue a porcentagem da mesma medição."}},"ru":{"stringUnit":{"state":"translated","value":"Процент жира — доля жира в массе тела; жировая масса — его масса. Диапазоны массы зависят от веса; статус определяется процентом жира того же измерения."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體脂率是脂肪佔體重的比例；脂肪量是對應的質量。質量範圍隨體重變化，狀態按同次體脂率判斷。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"体脂率是脂肪占体重的比例；脂肪量是对应的质量。质量范围随体重变化，状态按同次体脂率判断。"}}}},
    "身体水分是水分占体重的比例；水分量是对应的质量。质量范围随体重变化，状态按同次水分率判断。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Body water percentage is the proportion of weight that is water; water mass is its mass. Mass ranges depend on weight; status follows water percentage from the same measurement."}},"de":{"stringUnit":{"state":"translated","value":"Körperwasseranteil ist der Wasseranteil am Gewicht; Wassermasse ist die entsprechende Masse. Massenbereiche hängen vom Gewicht ab; der Status folgt dem Wasseranteil derselben Messung."}},"es":{"stringUnit":{"state":"translated","value":"El porcentaje de agua es la proporción del peso que es agua; la masa de agua es su masa. Los rangos dependen del peso; el estado sigue el porcentaje de agua de la misma medición."}},"fr":{"stringUnit":{"state":"translated","value":"Le taux d’eau est la part du poids constituée d’eau ; la masse d’eau en est la masse. Les plages dépendent du poids ; le statut suit le taux d’eau de la même mesure."}},"ja":{"stringUnit":{"state":"translated","value":"体水分率は体重に占める水分の割合、水分量はその質量です。質量の範囲は体重で変わり、状態は同じ測定の水分率で判定します。"}},"ko":{"stringUnit":{"state":"translated","value":"체수분률은 체중 중 수분의 비율이며 수분량은 해당 질량입니다. 질량 범위는 체중에 따라 달라지며 상태는 같은 측정의 수분률로 판단합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A porcentagem de água é a fração do peso composta por água; a massa de água é sua massa. As faixas dependem do peso; o estado segue a porcentagem de água da mesma medição."}},"ru":{"stringUnit":{"state":"translated","value":"Процент воды — доля воды в массе тела; масса воды — её масса. Диапазоны зависят от веса; статус определяется процентом воды того же измерения."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體水分是水分佔體重的比例；水分量是對應的質量。質量範圍隨體重變化，狀態按同次水分率判斷。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"身体水分是水分占体重的比例；水分量是对应的质量。质量范围随体重变化，状态按同次水分率判断。"}}}},
    "内脏脂肪反映腹腔内脂肪相关水平。这里的数值是指数，不是质量或百分比；不同算法的范围不能直接通用。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Visceral fat reflects fat around internal abdominal organs. This value is an index, not mass or percentage; ranges are not interchangeable between algorithms."}},"de":{"stringUnit":{"state":"translated","value":"Viszeralfett beschreibt Fett im Bauchraum. Dieser Wert ist ein Index, keine Masse oder Prozentangabe; Bereiche verschiedener Algorithmen sind nicht austauschbar."}},"es":{"stringUnit":{"state":"translated","value":"La grasa visceral refleja grasa en el abdomen. Este valor es un índice, no masa ni porcentaje; los rangos no son intercambiables entre algoritmos."}},"fr":{"stringUnit":{"state":"translated","value":"La graisse viscérale reflète la graisse abdominale interne. Cette valeur est un indice, pas une masse ni un pourcentage ; les plages diffèrent selon les algorithmes."}},"ja":{"stringUnit":{"state":"translated","value":"内臓脂肪は腹腔内の脂肪に関する指標です。この値は質量や割合ではなく指数で、異なる計算方式の基準は共通に使えません。"}},"ko":{"stringUnit":{"state":"translated","value":"내장지방은 복강 내 지방 수준을 나타냅니다. 이 값은 질량이나 백분율이 아닌 지수이며 서로 다른 알고리즘의 범위는 호환되지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A gordura visceral reflete gordura interna abdominal. Este valor é um índice, não massa nem porcentagem; faixas de algoritmos diferentes não são intercambiáveis."}},"ru":{"stringUnit":{"state":"translated","value":"Висцеральный жир отражает жир внутри брюшной полости. Это индекс, не масса и не процент; диапазоны разных алгоритмов не взаимозаменяемы."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內臟脂肪反映腹腔內脂肪相關水平。這裡的數值是指數，不是質量或百分比；不同演算法的範圍不能直接通用。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内脏脂肪反映腹腔内脂肪相关水平。这里的数值是指数，不是质量或百分比；不同算法的范围不能直接通用。"}}}},
    "基础代谢描述静息状态下维持基本生命活动的每日能量需求，不是全天总消耗。它受年龄、性别及体型影响，没有统一的高低范围。" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Basal metabolism describes daily energy needed to sustain basic functions at rest, not total daily expenditure. It depends on age, sex and body size, with no universal high or low range."}},"de":{"stringUnit":{"state":"translated","value":"Grundumsatz beschreibt den täglichen Energiebedarf für grundlegende Funktionen in Ruhe, nicht den gesamten Tagesverbrauch. Er hängt von Alter, Geschlecht und Körpergröße ab; es gibt keine universellen Grenzwerte."}},"es":{"stringUnit":{"state":"translated","value":"El metabolismo basal describe la energía diaria necesaria para las funciones básicas en reposo, no el gasto diario total. Depende de edad, sexo y tamaño corporal; no hay límites universales."}},"fr":{"stringUnit":{"state":"translated","value":"Le métabolisme basal décrit l’énergie quotidienne nécessaire aux fonctions vitales au repos, pas la dépense totale. Il dépend de l’âge, du sexe et de la corpulence, sans seuil universel."}},"ja":{"stringUnit":{"state":"translated","value":"基礎代謝は安静時に基本的な生命活動を維持する一日の必要エネルギーで、総消費量ではありません。年齢、性別、体格に依存し、一律の高低基準はありません。"}},"ko":{"stringUnit":{"state":"translated","value":"기초대사는 안정 시 기본 생명 활동 유지에 필요한 하루 에너지이며 하루 총소모량이 아닙니다. 나이, 성별, 체격에 따라 달라 보편적인 고저 기준은 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O metabolismo basal descreve a energia diária necessária para funções básicas em repouso, não o gasto diário total. Depende de idade, sexo e tamanho corporal, sem limites universais."}},"ru":{"stringUnit":{"state":"translated","value":"Основной обмен — суточная энергия для основных функций в покое, а не общий расход за день. Он зависит от возраста, пола и размеров тела; универсальных порогов нет."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"基礎代謝描述靜息狀態下維持基本生命活動的每日能量需求，不是全天總消耗。它受年齡、性別及體型影響，沒有統一的高低範圍。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"基础代谢描述静息状态下维持基本生命活动的每日能量需求，不是全天总消耗。它受年龄、性别及体型影响，没有统一的高低范围。"}}}},
    "低于 %@" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"低于 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"低於 %@"}},"en":{"stringUnit":{"state":"translated","value":"Below %@"}},"de":{"stringUnit":{"state":"translated","value":"Unter %@"}},"es":{"stringUnit":{"state":"translated","value":"Menos de %@"}},"fr":{"stringUnit":{"state":"translated","value":"Moins de %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ 未満"}},"ko":{"stringUnit":{"state":"translated","value":"%@ 미만"}},"pt":{"stringUnit":{"state":"translated","value":"Abaixo de %@"}},"ru":{"stringUnit":{"state":"translated","value":"Ниже %@"}}}},
    "高于 %@" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"高于 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"高於 %@"}},"en":{"stringUnit":{"state":"translated","value":"Above %@"}},"de":{"stringUnit":{"state":"translated","value":"Über %@"}},"es":{"stringUnit":{"state":"translated","value":"Más de %@"}},"fr":{"stringUnit":{"state":"translated","value":"Plus de %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ 超"}},"ko":{"stringUnit":{"state":"translated","value":"%@ 초과"}},"pt":{"stringUnit":{"state":"translated","value":"Acima de %@"}},"ru":{"stringUnit":{"state":"translated","value":"Выше %@"}}}},
