    "%@ 及以下" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 及以下"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 及以下"}},"en":{"stringUnit":{"state":"translated","value":"%@ and below"}},"de":{"stringUnit":{"state":"translated","value":"%@ und weniger"}},"es":{"stringUnit":{"state":"translated","value":"%@ o menos"}},"fr":{"stringUnit":{"state":"translated","value":"%@ et moins"}},"ja":{"stringUnit":{"state":"translated","value":"%@ 以下"}},"ko":{"stringUnit":{"state":"translated","value":"%@ 이하"}},"pt":{"stringUnit":{"state":"translated","value":"%@ ou menos"}},"ru":{"stringUnit":{"state":"translated","value":"%@ и ниже"}}}},
    "不评级" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Unbewertet"}},"en":{"stringUnit":{"state":"translated","value":"Unrated"}},"es":{"stringUnit":{"state":"translated","value":"Sin evaluar"}},"fr":{"stringUnit":{"state":"translated","value":"Non évalué"}},"ja":{"stringUnit":{"state":"translated","value":"評価なし"}},"ko":{"stringUnit":{"state":"translated","value":"평가 없음"}},"pt":{"stringUnit":{"state":"translated","value":"Sem avaliação"}},"ru":{"stringUnit":{"state":"translated","value":"Без оценки"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不评级"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不評級"}}}},
    "参考资料" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Referenzmaterial"}},"en":{"stringUnit":{"state":"translated","value":"References"}},"es":{"stringUnit":{"state":"translated","value":"Referencias"}},"fr":{"stringUnit":{"state":"translated","value":"Références"}},"ja":{"stringUnit":{"state":"translated","value":"参考資料"}},"ko":{"stringUnit":{"state":"translated","value":"참고 자료"}},"pt":{"stringUnit":{"state":"translated","value":"Referências"}},"ru":{"stringUnit":{"state":"translated","value":"Источники"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参考资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參考資料"}}}},
    "测量时年龄（含小数）" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"测量时年龄（含小数）"}},"en":{"stringUnit":{"state":"translated","value":"Age at measurement (decimal years)"}},"de":{"stringUnit":{"state":"translated","value":"Alter bei Messung (Dezimaljahre)"}},"es":{"stringUnit":{"state":"translated","value":"Edad al medir (años decimales)"}},"fr":{"stringUnit":{"state":"translated","value":"Âge à la mesure (années décimales)"}},"ja":{"stringUnit":{"state":"translated","value":"測定時の年齢（小数年）"}},"ko":{"stringUnit":{"state":"translated","value":"측정 시 나이(소수 연도)"}},"pt":{"stringUnit":{"state":"translated","value":"Idade na medição (anos decimais)"}},"ru":{"stringUnit":{"state":"translated","value":"Возраст при измерении (дробные годы)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測量時年齡（含小數）"}}}},
    "测量时周岁" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"测量时周岁"}},"en":{"stringUnit":{"state":"translated","value":"Completed years at measurement"}},"de":{"stringUnit":{"state":"translated","value":"Vollendete Lebensjahre bei Messung"}},"es":{"stringUnit":{"state":"translated","value":"Años cumplidos al medir"}},"fr":{"stringUnit":{"state":"translated","value":"Années révolues à la mesure"}},"ja":{"stringUnit":{"state":"translated","value":"測定時の満年齢"}},"ko":{"stringUnit":{"state":"translated","value":"측정 시 만 나이"}},"pt":{"stringUnit":{"state":"translated","value":"Anos completos na medição"}},"ru":{"stringUnit":{"state":"translated","value":"Полных лет при измерении"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測量時周歲"}}}},
    "性别编码：男 1，女 0" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"性别编码：男 1，女 0"}},"en":{"stringUnit":{"state":"translated","value":"Sex code: male 1, female 0"}},"de":{"stringUnit":{"state":"translated","value":"Geschlechtscode: männlich 1, weiblich 0"}},"es":{"stringUnit":{"state":"translated","value":"Código de sexo: hombre 1, mujer 0"}},"fr":{"stringUnit":{"state":"translated","value":"Code du sexe : homme 1, femme 0"}},"ja":{"stringUnit":{"state":"translated","value":"性別コード：男性 1、女性 0"}},"ko":{"stringUnit":{"state":"translated","value":"성별 코드: 남성 1, 여성 0"}},"pt":{"stringUnit":{"state":"translated","value":"Código de sexo: masculino 1, feminino 0"}},"ru":{"stringUnit":{"state":"translated","value":"Код пола: мужчина 1, женщина 0"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"性別編碼：男 1，女 0"}}}},
    "男性 / 女性" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"男性 / 女性"}},"en":{"stringUnit":{"state":"translated","value":"Male / Female"}},"de":{"stringUnit":{"state":"translated","value":"Männlich / Weiblich"}},"es":{"stringUnit":{"state":"translated","value":"Hombre / Mujer"}},"fr":{"stringUnit":{"state":"translated","value":"Homme / Femme"}},"ja":{"stringUnit":{"state":"translated","value":"男性 / 女性"}},"ko":{"stringUnit":{"state":"translated","value":"남성 / 여성"}},"pt":{"stringUnit":{"state":"translated","value":"Masculino / Feminino"}},"ru":{"stringUnit":{"state":"translated","value":"Мужчина / Женщина"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"男性 / 女性"}}}},
    "去脂体重指数" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"去脂体重指数"}},"en":{"stringUnit":{"state":"translated","value":"Fat-free mass index"}},"de":{"stringUnit":{"state":"translated","value":"Index der fettfreien Masse"}},"es":{"stringUnit":{"state":"translated","value":"Índice de masa libre de grasa"}},"fr":{"stringUnit":{"state":"translated","value":"Indice de masse maigre"}},"ja":{"stringUnit":{"state":"translated","value":"除脂肪量指数"}},"ko":{"stringUnit":{"state":"translated","value":"제지방량 지수"}},"pt":{"stringUnit":{"state":"translated","value":"Índice de massa livre de gordura"}},"ru":{"stringUnit":{"state":"translated","value":"Индекс безжировой массы"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"去脂體重指數"}}}},
    "先使用 Sun 分支；0.732 仅用于有去脂体重、已满 18 岁且未选中 Sun 分支的记录。Sun 结果无效时不改用固定比例。水分量按 1 L ≈ 1 kg 换算。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"先使用 Sun 分支；0.732 仅用于有去脂体重、已满 18 岁且未选中 Sun 分支的记录。Sun 结果无效时不改用固定比例。水分量按 1 L ≈ 1 kg 换算。"}},"en":{"stringUnit":{"state":"translated","value":"Use the Sun branch first. The 0.732 factor applies only when fat-free mass is available, age is at least 18, and Sun was not selected. Invalid Sun results do not fall back to a fixed ratio. Water is converted at 1 L ≈ 1 kg."}},"de":{"stringUnit":{"state":"translated","value":"Zuerst gilt der Sun-Zweig. Der Faktor 0,732 gilt nur bei vorhandener fettfreier Masse ab 18 Jahren, wenn Sun nicht ausgewählt wurde. Ungültige Sun-Ergebnisse werden nicht durch ein festes Verhältnis ersetzt. Wasser wird mit 1 L ≈ 1 kg umgerechnet."}},"es":{"stringUnit":{"state":"translated","value":"Se usa primero Sun. El factor 0,732 solo se aplica con masa libre de grasa disponible, edad mínima de 18 años y sin seleccionar Sun. Un resultado Sun inválido no se sustituye por una proporción fija. Se convierte el agua a 1 L ≈ 1 kg."}},"fr":{"stringUnit":{"state":"translated","value":"La branche Sun est prioritaire. Le facteur 0,732 exige une masse maigre disponible, un âge d’au moins 18 ans et une branche autre que Sun. Un résultat Sun invalide ne déclenche pas de ratio fixe. Conversion de l’eau : 1 L ≈ 1 kg."}},"ja":{"stringUnit":{"state":"translated","value":"Sun 分岐を優先します。0.732 は除脂肪量があり、18 歳以上で Sun が選択されていない場合のみ使用します。Sun の結果が無効でも固定比率に切り替えません。水分は 1 L ≈ 1 kg で換算します。"}},"ko":{"stringUnit":{"state":"translated","value":"Sun 분기를 우선합니다. 0.732는 제지방량이 있고 만 18세 이상이며 Sun이 선택되지 않은 경우에만 적용합니다. Sun 결과가 유효하지 않아도 고정 비율로 대체하지 않습니다. 수분은 1 L ≈ 1 kg으로 환산합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Usa-se primeiro o ramo Sun. O fator 0,732 exige massa livre de gordura disponível, idade mínima de 18 anos e que Sun não tenha sido selecionado. Resultados Sun inválidos não usam uma proporção fixa. A água é convertida a 1 L ≈ 1 kg."}},"ru":{"stringUnit":{"state":"translated","value":"Сначала используется ветвь Sun. Коэффициент 0,732 применяется только при наличии безжировой массы, возрасте от 18 лет и если Sun не выбран. Недопустимый результат Sun не заменяется фиксированной долей. Вода переводится по соотношению 1 л ≈ 1 кг."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先使用 Sun 分支；0.732 僅用於有去脂體重、已滿 18 歲且未選中 Sun 分支的記錄。Sun 結果無效時不改用固定比例。水分量按 1 L ≈ 1 kg 換算。"}}}},
    "按体重、身高、年龄和性别使用 Mifflin–St Jeor 公式，适用于 19–78 岁。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"按体重、身高、年龄和性别使用 Mifflin–St Jeor 公式，适用于 19–78 岁。"}},"en":{"stringUnit":{"state":"translated","value":"Uses weight, height, age and sex in the Mifflin–St Jeor equation for ages 19–78."}},"de":{"stringUnit":{"state":"translated","value":"Mifflin–St Jeor verwendet Gewicht, Größe, Alter und Geschlecht für 19–78 Jahre."}},"es":{"stringUnit":{"state":"translated","value":"Usa peso, altura, edad y sexo en la fórmula Mifflin–St Jeor para 19–78 años."}},"fr":{"stringUnit":{"state":"translated","value":"La formule Mifflin–St Jeor utilise poids, taille, âge et sexe de 19 à 78 ans."}},"ja":{"stringUnit":{"state":"translated","value":"19～78 歳を対象に、体重・身長・年齢・性別から Mifflin–St Jeor 式で計算します。"}},"ko":{"stringUnit":{"state":"translated","value":"19–78세의 체중, 키, 나이, 성별을 Mifflin–St Jeor 공식에 적용합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Usa peso, altura, idade e sexo na fórmula Mifflin–St Jeor entre 19–78 anos."}},"ru":{"stringUnit":{"state":"translated","value":"Формула Mifflin–St Jeor использует вес, рост, возраст и пол для 19–78 лет."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按體重、身高、年齡和性別使用 Mifflin–St Jeor 公式，適用於 19–78 歲。"}}}},
    "BMI＝体重（kg）÷身高（m）的平方。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"BMI＝体重（kg）÷身高（m）的平方。"}},"en":{"stringUnit":{"state":"translated","value":"BMI = weight (kg) ÷ height (m) squared."}},"de":{"stringUnit":{"state":"translated","value":"BMI = Gewicht (kg) ÷ Körpergröße (m) zum Quadrat."}},"es":{"stringUnit":{"state":"translated","value":"IMC = peso (kg) ÷ altura (m) al cuadrado."}},"fr":{"stringUnit":{"state":"translated","value":"IMC = poids (kg) ÷ taille (m) au carré."}},"ja":{"stringUnit":{"state":"translated","value":"BMI＝体重（kg）÷身長（m）の2乗。"}},"ko":{"stringUnit":{"state":"translated","value":"BMI = 체중(kg) ÷ 키(m)의 제곱."}},"pt":{"stringUnit":{"state":"translated","value":"IMC = peso (kg) ÷ altura (m) ao quadrado."}},"ru":{"stringUnit":{"state":"translated","value":"ИМТ = вес (кг) ÷ квадрат роста (м)."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BMI＝體重（kg）÷身高（m）的平方。"}}}},
    "按年龄选择阻抗模型估算去脂体重，再换算体脂率，适用于 3.9–94 岁。应用对设备频率和电极路径的适配仍属实验性。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"按年龄选择阻抗模型估算去脂体重，再换算体脂率，适用于 3.9–94 岁。应用对设备频率和电极路径的适配仍属实验性。"}},"en":{"stringUnit":{"state":"translated","value":"An age-based impedance model estimates fat-free mass, then body fat percentage, for ages 3.9–94. Mapping device frequency and electrode paths remains experimental."}},"de":{"stringUnit":{"state":"translated","value":"Ein altersabhängiges Impedanzmodell berechnet fettfreie Masse und Körperfettanteil für 3,9–94 Jahre. Die Anpassung an Gerätefrequenz und Elektrodenpfad bleibt experimentell."}},"es":{"stringUnit":{"state":"translated","value":"Un modelo de impedancia por edad estima masa libre de grasa y porcentaje de grasa entre 3,9–94 años. La adaptación de frecuencia y trayectoria de electrodos sigue siendo experimental."}},"fr":{"stringUnit":{"state":"translated","value":"Un modèle d’impédance selon l’âge estime la masse maigre puis le taux de graisse entre 3,9 et 94 ans. L’adaptation à la fréquence et au trajet des électrodes reste expérimentale."}},"ja":{"stringUnit":{"state":"translated","value":"3.9～94 歳を対象に年齢別のインピーダンス式で除脂肪量を推定し、体脂肪率に換算します。機器の周波数と電極経路への適用は実験的です。"}},"ko":{"stringUnit":{"state":"translated","value":"3.9–94세에서 연령별 임피던스 모델로 제지방량을 추정한 뒤 체지방률로 환산합니다. 기기 주파수 및 전극 경로 적용은 실험적입니다."}},"pt":{"stringUnit":{"state":"translated","value":"Um modelo de impedância por idade estima massa livre de gordura e percentual de gordura entre 3,9–94 anos. A adaptação à frequência e ao percurso dos elétrodos é experimental."}},"ru":{"stringUnit":{"state":"translated","value":"Возрастная модель импеданса оценивает безжировую массу и долю жира для 3,9–94 лет. Адаптация частоты прибора и пути электродов остаётся экспериментальной."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按年齡選擇阻抗模型估算去脂體重，再換算體脂率，適用於 3.9–94 歲。應用對裝置頻率和電極路徑的適配仍屬實驗性。"}}}},
    "脂肪量＝体重×体脂率÷100。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"脂肪量＝体重×体脂率÷100。"}},"en":{"stringUnit":{"state":"translated","value":"Fat mass = weight × body fat percentage ÷ 100."}},"de":{"stringUnit":{"state":"translated","value":"Fettmasse = Gewicht × Körperfettanteil ÷ 100."}},"es":{"stringUnit":{"state":"translated","value":"Masa grasa = peso × porcentaje de grasa ÷ 100."}},"fr":{"stringUnit":{"state":"translated","value":"Masse grasse = poids × taux de graisse ÷ 100."}},"ja":{"stringUnit":{"state":"translated","value":"脂肪量＝体重×体脂肪率÷100。"}},"ko":{"stringUnit":{"state":"translated","value":"지방량 = 체중 × 체지방률 ÷ 100."}},"pt":{"stringUnit":{"state":"translated","value":"Massa gorda = peso × percentual de gordura ÷ 100."}},"ru":{"stringUnit":{"state":"translated","value":"Жировая масса = вес × процент жира ÷ 100."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"脂肪量＝體重×體脂率÷100。"}}}},
    "成人肌肉量按去脂体重减去骨量估算，肌肉率按肌肉量占体重的比例计算。这里采用应用的无骨瘦体重代理规则。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"成人肌肉量按去脂体重减去骨量估算，肌肉率按肌肉量占体重的比例计算。这里采用应用的无骨瘦体重代理规则。"}},"en":{"stringUnit":{"state":"translated","value":"Adult muscle mass is estimated as fat-free mass minus bone mass; its percentage is relative to weight. The app uses bone-free lean mass as a proxy."}},"de":{"stringUnit":{"state":"translated","value":"Muskelmasse bei Erwachsenen wird als fettfreie Masse minus Knochenmasse geschätzt; der Anteil bezieht sich auf das Gewicht. Die App nutzt knochenfreie Magermasse als Näherung."}},"es":{"stringUnit":{"state":"translated","value":"En adultos, la masa muscular se estima restando la masa ósea a la masa libre de grasa; el porcentaje se calcula sobre el peso. La app usa masa magra sin hueso como aproximación."}},"fr":{"stringUnit":{"state":"translated","value":"Chez l’adulte, la masse musculaire est estimée par masse maigre moins masse osseuse ; le taux est rapporté au poids. L’application utilise la masse maigre sans os comme approximation."}},"ja":{"stringUnit":{"state":"translated","value":"成人の筋肉量は除脂肪量から骨量を引いて推定し、筋肉率は体重に対する割合で計算します。骨を除いた除脂肪量を代理値とします。"}},"ko":{"stringUnit":{"state":"translated","value":"성인 근육량은 제지방량에서 골량을 빼서 추정하고 근육률은 체중 대비 비율로 계산합니다. 앱은 뼈를 제외한 제지방량을 대리값으로 사용합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Em adultos, a massa muscular é estimada subtraindo massa óssea da massa livre de gordura; a percentagem é relativa ao peso. A app usa massa magra sem osso como aproximação."}},"ru":{"stringUnit":{"state":"translated","value":"Мышечная масса взрослых оценивается вычитанием костной массы из безжировой; доля рассчитывается относительно веса. Приложение использует безжировую массу без костей как приближение."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"成人肌肉量按去脂體重減去骨量估算，肌肉率按肌肉量占體重的比例計算。這裡採用應用的無骨瘦體重代理規則。"}}}},
    "水分量使用 Sun 模型或成人去脂体重的 0.732 比例估算，水分率按水分量占体重的比例计算。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"水分量使用 Sun 模型或成人去脂体重的 0.732 比例估算，水分率按水分量占体重的比例计算。"}},"en":{"stringUnit":{"state":"translated","value":"Water mass uses the Sun model or 0.732 of adult fat-free mass; water percentage is relative to weight."}},"de":{"stringUnit":{"state":"translated","value":"Wassermasse folgt dem Sun-Modell oder 0,732 der fettfreien Masse Erwachsener; der Wasseranteil bezieht sich auf das Gewicht."}},"es":{"stringUnit":{"state":"translated","value":"El agua corporal se estima con Sun o 0,732 de la masa libre de grasa adulta; el porcentaje se calcula sobre el peso."}},"fr":{"stringUnit":{"state":"translated","value":"La masse d’eau suit Sun ou 0,732 de la masse maigre adulte ; le taux est rapporté au poids."}},"ja":{"stringUnit":{"state":"translated","value":"水分量は Sun 式または成人の除脂肪量×0.732で推定し、水分率は体重に対する割合で計算します。"}},"ko":{"stringUnit":{"state":"translated","value":"수분량은 Sun 모델 또는 성인 제지방량의 0.732로 추정하고 수분률은 체중 대비 비율로 계산합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A água corporal usa Sun ou 0,732 da massa livre de gordura adulta; a percentagem é relativa ao peso."}},"ru":{"stringUnit":{"state":"translated","value":"Масса воды оценивается по Sun или как 0,732 безжировой массы взрослых; доля рассчитывается относительно веса."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"水分量使用 Sun 模型或成人去脂體重的 0.732 比例估算，水分率按水分量占體重的比例計算。"}}}},
    "成人骨量＝去脂体重×0.052；骨量占比＝骨量÷体重×100。0.052 为应用经验系数。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"成人骨量＝去脂体重×0.052；骨量占比＝骨量÷体重×100。0.052 为应用经验系数。"}},"en":{"stringUnit":{"state":"translated","value":"Adult bone mass = fat-free mass × 0.052; bone percentage = bone mass ÷ weight × 100. The factor 0.052 is an app heuristic."}},"de":{"stringUnit":{"state":"translated","value":"Knochenmasse Erwachsener = fettfreie Masse × 0,052; Anteil = Knochenmasse ÷ Gewicht × 100. 0,052 ist eine App-Heuristik."}},"es":{"stringUnit":{"state":"translated","value":"Masa ósea adulta = masa libre de grasa × 0,052; porcentaje = masa ósea ÷ peso × 100. 0,052 es un coeficiente empírico de la app."}},"fr":{"stringUnit":{"state":"translated","value":"Masse osseuse adulte = masse maigre × 0,052 ; taux = masse osseuse ÷ poids × 100. 0,052 est un coefficient empirique de l’application."}},"ja":{"stringUnit":{"state":"translated","value":"成人の骨量＝除脂肪量×0.052、骨量比率＝骨量÷体重×100。0.052はアプリ独自の経験係数です。"}},"ko":{"stringUnit":{"state":"translated","value":"성인 골량 = 제지방량 × 0.052, 골량 비율 = 골량 ÷ 체중 × 100. 0.052는 앱의 경험 계수입니다."}},"pt":{"stringUnit":{"state":"translated","value":"Massa óssea adulta = massa livre de gordura × 0,052; percentagem = massa óssea ÷ peso × 100. 0,052 é um coeficiente empírico da app."}},"ru":{"stringUnit":{"state":"translated","value":"Костная масса взрослых = безжировая масса × 0,052; доля = костная масса ÷ вес × 100. 0,052 — эмпирический коэффициент приложения."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"成人骨量＝去脂體重×0.052；骨量占比＝骨量÷體重×100。0.052 為應用經驗係數。"}}}},
    "按成人体脂率和年龄计算应用经验指数，结果限制在 1–30。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"按成人体脂率和年龄计算应用经验指数，结果限制在 1–30。"}},"en":{"stringUnit":{"state":"translated","value":"An app heuristic uses adult body fat percentage and age, with results limited to 1–30."}},"de":{"stringUnit":{"state":"translated","value":"Eine App-Heuristik verwendet Körperfettanteil und Alter Erwachsener; Ergebnisse sind auf 1–30 begrenzt."}},"es":{"stringUnit":{"state":"translated","value":"Un índice empírico usa grasa corporal y edad adultas, con resultados entre 1–30."}},"fr":{"stringUnit":{"state":"translated","value":"Un indice empirique utilise le taux de graisse et l’âge adultes, avec un résultat limité à 1–30."}},"ja":{"stringUnit":{"state":"translated","value":"成人の体脂肪率と年齢からアプリ独自の経験指数を計算し、1～30に制限します。"}},"ko":{"stringUnit":{"state":"translated","value":"성인 체지방률과 나이로 앱 경험 지수를 계산하며 결과는 1–30으로 제한합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Um índice empírico usa gordura corporal e idade adultas, limitado a 1–30."}},"ru":{"stringUnit":{"state":"translated","value":"Эмпирический индекс приложения использует долю жира и возраст взрослых, результат ограничен 1–30."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按成人體脂率和年齡計算應用經驗指數，結果限制在 1–30。"}}}},
    "去脂体重＝体重×（1−体脂率÷100）。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"去脂体重＝体重×（1−体脂率÷100）。"}},"en":{"stringUnit":{"state":"translated","value":"Fat-free mass = weight × (1 − body fat percentage ÷ 100)."}},"de":{"stringUnit":{"state":"translated","value":"Fettfreie Masse = Gewicht × (1 − Körperfettanteil ÷ 100)."}},"es":{"stringUnit":{"state":"translated","value":"Masa libre de grasa = peso × (1 − porcentaje de grasa ÷ 100)."}},"fr":{"stringUnit":{"state":"translated","value":"Masse maigre = poids × (1 − taux de graisse ÷ 100)."}},"ja":{"stringUnit":{"state":"translated","value":"除脂肪量＝体重×（1−体脂肪率÷100）。"}},"ko":{"stringUnit":{"state":"translated","value":"제지방량 = 체중 × (1 − 체지방률 ÷ 100)."}},"pt":{"stringUnit":{"state":"translated","value":"Massa livre de gordura = peso × (1 − percentual de gordura ÷ 100)."}},"ru":{"stringUnit":{"state":"translated","value":"Безжировая масса = вес × (1 − процент жира ÷ 100)."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"去脂體重＝體重×（1−體脂率÷100）。"}}}},
    "使用 Schofield 公式，按年龄和性别选择系数，由体重计算每日基础代谢。" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Schofield 公式，按年龄和性别选择系数，由体重计算每日基础代谢。"}},"en":{"stringUnit":{"state":"translated","value":"The Schofield equation uses age- and sex-specific coefficients to calculate daily basal metabolism from weight."}},"de":{"stringUnit":{"state":"translated","value":"Die Schofield-Gleichung berechnet den täglichen Grundumsatz aus dem Gewicht mit alters- und geschlechtsspezifischen Koeffizienten."}},"es":{"stringUnit":{"state":"translated","value":"Schofield calcula el metabolismo basal diario a partir del peso con coeficientes por edad y sexo."}},"fr":{"stringUnit":{"state":"translated","value":"Schofield calcule le métabolisme basal quotidien à partir du poids avec des coefficients selon l’âge et le sexe."}},"ja":{"stringUnit":{"state":"translated","value":"Schofield 式で年齢・性別ごとの係数を選び、体重から1日の基礎代謝を計算します。"}},"ko":{"stringUnit":{"state":"translated","value":"Schofield 공식에서 나이와 성별에 따른 계수를 선택하여 체중으로 일일 기초대사량을 계산합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Schofield calcula o metabolismo basal diário pelo peso com coeficientes por idade e sexo."}},"ru":{"stringUnit":{"state":"translated","value":"Формула Schofield рассчитывает суточный основной обмен по весу с коэффициентами для возраста и пола."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用 Schofield 公式，按年齡和性別選擇係數，由體重計算每日基礎代謝。"}}}}
  },
  "version" : "1.0"
}
