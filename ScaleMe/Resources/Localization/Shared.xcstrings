    "保留每次测量及其真实时间位置": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Jede Messung an ihrer tatsächlichen Zeitposition beibehalten"}},"en":{"stringUnit":{"state":"translated","value":"Keep every measurement at its actual time"}},"es":{"stringUnit":{"state":"translated","value":"Conservar cada medición en su momento real"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver chaque mesure à son heure réelle"}},"ja":{"stringUnit":{"state":"translated","value":"各測定を実際の時刻位置に表示"}},"ko":{"stringUnit":{"state":"translated","value":"각 측정값을 실제 측정 시간에 표시"}},"pt":{"stringUnit":{"state":"translated","value":"Manter cada medição na respetiva hora real"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранять каждое измерение в его фактическом времени"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留每次测量及其真实时间位置"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"保留每次測量及其實際時間位置"}}}},
    "偏低": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Low"}},"en":{"stringUnit":{"state":"translated","value":"Low"}},"es":{"stringUnit":{"state":"translated","value":"Low"}},"fr":{"stringUnit":{"state":"translated","value":"Low"}},"ja":{"stringUnit":{"state":"translated","value":"Low"}},"ko":{"stringUnit":{"state":"translated","value":"Low"}},"pt":{"stringUnit":{"state":"translated","value":"Low"}},"ru":{"stringUnit":{"state":"translated","value":"Low"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"偏低"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"偏低"}}}},
