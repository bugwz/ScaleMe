    "一个 JSON 文件同时包含完整配置和测量记录。": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine JSON-Datei enthält die vollständige Konfiguration und alle Messwerte."}},"en":{"stringUnit":{"state":"translated","value":"One JSON file containing the full configuration and measurement records."}},"es":{"stringUnit":{"state":"translated","value":"Un archivo JSON que contiene la configuración completa y los registros de medición."}},"fr":{"stringUnit":{"state":"translated","value":"Un fichier JSON contenant la configuration complète et les mesures."}},"ja":{"stringUnit":{"state":"translated","value":"完全な設定と測定記録を1つのJSONファイルにまとめます。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 설정과 측정 기록을 하나의 JSON 파일에 포함합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Um ficheiro JSON com a configuração completa e os registos de medição."}},"ru":{"stringUnit":{"state":"translated","value":"Один файл JSON с полной конфигурацией и записями измерений."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一个 JSON 文件同时包含完整配置和测量记录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一個 JSON 檔案同時包含完整設定和測量記錄。"}}}},
    "了解数据处理、系统权限、导入导出与删除方式": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Informationen zu Datenverarbeitung, Berechtigungen, Import, Export und Löschung"}},"en":{"stringUnit":{"state":"translated","value":"Learn about data handling, permissions, import, export, and deletion"}},"es":{"stringUnit":{"state":"translated","value":"Información sobre datos, permisos, importación, exportación y eliminación"}},"fr":{"stringUnit":{"state":"translated","value":"Comprendre les données, autorisations, importations, exportations et suppressions"}},"ja":{"stringUnit":{"state":"translated","value":"データ処理、権限、読み込み、書き出し、削除について"}},"ko":{"stringUnit":{"state":"translated","value":"데이터 처리, 권한, 가져오기, 내보내기 및 삭제 안내"}},"pt":{"stringUnit":{"state":"translated","value":"Saiba mais sobre dados, permissões, importação, exportação e eliminação"}},"ru":{"stringUnit":{"state":"translated","value":"Об обработке данных, разрешениях, импорте, экспорте и удалении"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"了解数据处理、系统权限、导入导出与删除方式"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"瞭解資料處理、系統權限、匯入匯出與刪除方式"}}}},
    "人物形象": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Avatar"}},"en":{"stringUnit":{"state":"translated","value":"Avatar"}},"es":{"stringUnit":{"state":"translated","value":"Avatar"}},"fr":{"stringUnit":{"state":"translated","value":"Avatar"}},"ja":{"stringUnit":{"state":"translated","value":"Avatar"}},"ko":{"stringUnit":{"state":"translated","value":"Avatar"}},"pt":{"stringUnit":{"state":"translated","value":"Avatar"}},"ru":{"stringUnit":{"state":"translated","value":"Avatar"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"人物形象"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"人物形象"}}}},
