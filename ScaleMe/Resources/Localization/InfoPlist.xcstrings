{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"pt":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我"}}}},
    "CFBundleName": {"comment":"Bundle name","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"pt":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"ScaleMe"}}}},
    "NSBluetoothAlwaysUsageDescription": {"comment":"Privacy - Bluetooth Always Usage Description","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe benötigt Bluetooth, um die von Ihnen aktiv verwendete Körperwaage zu finden und auszulesen."}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe needs Bluetooth to discover and read the weight and body-composition scales you actively use."}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe necesita Bluetooth para descubrir y leer las básculas de peso y composición corporal que utilices activamente."}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe a besoin du Bluetooth pour détecter et lire les balances de poids et de composition corporelle que vous utilisez activement."}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMeは、使用中の体重・体組成計を検出してデータを読み取るためにBluetoothを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe는 사용자가 직접 사용하는 체중계와 체성분계를 검색하고 데이터를 읽기 위해 Bluetooth가 필요합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A ScaleMe precisa de Bluetooth para detetar e ler as balanças de peso e composição corporal que utiliza ativamente."}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe использует Bluetooth для обнаружения и чтения данных весов и анализаторов состава тела, которыми вы активно пользуетесь."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我需要蓝牙来发现并读取您主动使用的体重体脂秤。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我需要藍牙來尋找並讀取您主動使用的體重體脂計。"}}}},
    "NSBluetoothPeripheralUsageDescription": {"comment":"Privacy - Bluetooth Peripheral Usage Description","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe benötigt Bluetooth, um eine Verbindung zu Körperwaagen herzustellen."}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe needs Bluetooth to connect to weight and body-composition scales."}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe necesita Bluetooth para conectarse a básculas de peso y composición corporal."}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe a besoin du Bluetooth pour se connecter aux balances de poids et de composition corporelle."}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMeは体重・体組成計に接続するためにBluetoothを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe는 체중계와 체성분계에 연결하기 위해 Bluetooth가 필요합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A ScaleMe precisa de Bluetooth para se ligar a balanças de peso e composição corporal."}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe использует Bluetooth для подключения к весам и анализаторам состава тела."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我需要蓝牙连接体重体脂秤。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我需要藍牙連接體重體脂計。"}}}},
    "NSHealthShareUsageDescription": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"观我读取 Apple 健康中的体重和体脂率，导入本人档案，用于汇总记录和查看长期变化趋势。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我讀取 Apple 健康中的體重和體脂率，匯入本人檔案，用於彙整記錄和查看長期變化趨勢。"}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe reads weight and body fat percentage from Apple Health into your profile to combine records and show long-term trends."}},"de":{"stringUnit":{"state":"translated","value":"ScaleMe liest Gewicht und Körperfettanteil aus Apple Health in Ihr Profil ein, um Aufzeichnungen zusammenzuführen und langfristige Trends anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe importa el peso y el porcentaje de grasa corporal de Apple Salud a su perfil para reunir registros y mostrar tendencias a largo plazo."}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe importe le poids et le pourcentage de masse grasse d’Apple Santé dans votre profil pour regrouper les mesures et afficher les tendances à long terme."}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMeはAppleヘルスケアから体重と体脂肪率を本人プロフィールに読み込み、記録の集約と長期的な変化の表示に使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe는 Apple 건강의 체중과 체지방률을 본인 프로필로 가져와 기록을 모으고 장기적인 변화를 보여줍니다."}},"pt":{"stringUnit":{"state":"translated","value":"O ScaleMe importa peso e percentagem de gordura corporal da Saúde Apple para o seu perfil, para reunir registos e mostrar tendências a longo prazo."}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe импортирует вес и процент жира из Apple Здоровья в ваш профиль, чтобы объединять записи и показывать долгосрочные тенденции."}}}},
    "NSHealthUpdateUsageDescription": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"观我将所选体重秤提供的体重和体脂率保存到 Apple 健康，方便您集中查看健康记录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我將所選體重計提供的體重和體脂率儲存至 Apple 健康，方便您集中查看健康記錄。"}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe saves weight and body fat percentage supplied by your selected scales to Apple Health so you can view your health records together."}},"de":{"stringUnit":{"state":"translated","value":"ScaleMe speichert Gewicht und Körperfettanteil Ihrer ausgewählten Waagen in Apple Health, damit Sie Ihre Gesundheitsdaten zusammen ansehen können."}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe guarda en Apple Salud el peso y el porcentaje de grasa corporal de las básculas seleccionadas para consultar sus registros de salud juntos."}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe enregistre dans Apple Santé le poids et le pourcentage de masse grasse fournis par les balances sélectionnées pour consulter vos mesures ensemble."}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMeは選択した体重計が提供する体重と体脂肪率をAppleヘルスケアに保存し、健康記録をまとめて確認できるようにします。"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe는 선택한 체중계가 제공한 체중과 체지방률을 Apple 건강에 저장하여 건강 기록을 한곳에서 볼 수 있게 합니다."}},"pt":{"stringUnit":{"state":"translated","value":"O ScaleMe guarda na Saúde Apple o peso e a percentagem de gordura corporal das balanças selecionadas para consultar os seus registos em conjunto."}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe сохраняет вес и процент жира с выбранных весов в Apple Здоровье, чтобы вы могли просматривать записи вместе."}}}}
  },
  "version": "1.0"
}
