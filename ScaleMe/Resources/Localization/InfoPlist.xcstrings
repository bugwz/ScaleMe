{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CFBundleDisplayName" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"pt":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"見微"}}}},
    "CFBundleName" : {"comment":"Bundle name","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"pt":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ScaleMe"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"ScaleMe"}}}},
    "NSBluetoothAlwaysUsageDescription" : {"comment":"Privacy - Bluetooth Always Usage Description","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe benötigt Bluetooth, um die von Ihnen aktiv verwendete Körperwaage zu finden und auszulesen."}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe needs Bluetooth to discover and read the weight and body-composition scales you actively use."}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe necesita Bluetooth para descubrir y leer las básculas de peso y composición corporal que utilices activamente."}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe a besoin du Bluetooth pour détecter et lire les balances de poids et de composition corporelle que vous utilisez activement."}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMeは、使用中の体重・体組成計を検出してデータを読み取るためにBluetoothを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe는 사용자가 직접 사용하는 체중계와 체성분계를 검색하고 데이터를 읽기 위해 Bluetooth가 필요합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A ScaleMe precisa de Bluetooth para detetar e ler as balanças de peso e composição corporal que utiliza ativamente."}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe использует Bluetooth для обнаружения и чтения данных весов и анализаторов состава тела, которыми вы активно пользуетесь."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我需要蓝牙来发现并读取您主动使用的体重体脂秤。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我需要藍牙來尋找並讀取您主動使用的體重體脂計。"}}}},
    "NSBluetoothPeripheralUsageDescription" : {"comment":"Privacy - Bluetooth Peripheral Usage Description","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe benötigt Bluetooth, um eine Verbindung zu Körperwaagen herzustellen."}},"en":{"stringUnit":{"state":"translated","value":"ScaleMe needs Bluetooth to connect to weight and body-composition scales."}},"es":{"stringUnit":{"state":"translated","value":"ScaleMe necesita Bluetooth para conectarse a básculas de peso y composición corporal."}},"fr":{"stringUnit":{"state":"translated","value":"ScaleMe a besoin du Bluetooth pour se connecter aux balances de poids et de composition corporelle."}},"ja":{"stringUnit":{"state":"translated","value":"ScaleMeは体重・体組成計に接続するためにBluetoothを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"ScaleMe는 체중계와 체성분계에 연결하기 위해 Bluetooth가 필요합니다."}},"pt":{"stringUnit":{"state":"translated","value":"A ScaleMe precisa de Bluetooth para se ligar a balanças de peso e composição corporal."}},"ru":{"stringUnit":{"state":"translated","value":"ScaleMe использует Bluetooth для подключения к весам и анализаторам состава тела."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我需要蓝牙连接体重体脂秤。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我需要藍牙連接體重體脂計。"}}}},
    "NSHealthShareUsageDescription" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe liest mit deiner Zustimmung Gewicht und Körperfett aus Apple Health und importiert sie in dein Profil."}},"en":{"stringUnit":{"state":"translated","value":"With your permission, ScaleMe reads weight and body fat from Apple Health and imports them into your profile."}},"es":{"stringUnit":{"state":"translated","value":"Con tu permiso, ScaleMe lee el peso y la grasa corporal de Apple Health y los importa en tu perfil."}},"fr":{"stringUnit":{"state":"translated","value":"Avec votre autorisation, ScaleMe lit le poids et la masse grasse dans Apple Santé et les importe dans votre profil."}},"ja":{"stringUnit":{"state":"translated","value":"許可された場合、ScaleMeはAppleヘルスケアから体重と体脂肪率を読み取り、本人プロフィールに読み込みます。"}},"ko":{"stringUnit":{"state":"translated","value":"사용자가 허용하면 ScaleMe가 Apple 건강에서 체중과 체지방률을 읽어 본인 프로필로 가져옵니다."}},"pt":{"stringUnit":{"state":"translated","value":"Com a sua permissão, o ScaleMe lê o peso e a gordura corporal da Saúde Apple e importa-os para o seu perfil."}},"ru":{"stringUnit":{"state":"translated","value":"С вашего разрешения ScaleMe читает вес и процент жира из Apple Здоровья и импортирует их в ваш профиль."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我仅在您同意后，从 Apple 健康读取体重和体脂率并导入本人档案。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我僅在您同意後，從 Apple 健康讀取體重和體脂率並匯入本人檔案。"}}}},
    "NSHealthUpdateUsageDescription" : {"comment":"Privacy - Health Update Usage Description","extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"ScaleMe schreibt mit Ihrer Zustimmung Gewicht und erfassten Körperfettanteil in Apple Health."}},"en":{"stringUnit":{"state":"translated","value":"With your permission, ScaleMe writes weight and recorded body fat to Apple Health."}},"es":{"stringUnit":{"state":"translated","value":"Con tu permiso, ScaleMe escribe el peso y la grasa registrada en Apple Salud."}},"fr":{"stringUnit":{"state":"translated","value":"Avec votre autorisation, ScaleMe écrit le poids et la graisse enregistrée dans Apple Santé."}},"ja":{"stringUnit":{"state":"translated","value":"許可された場合、ScaleMeは体重と記録した体脂肪をAppleヘルスケアに保存します。"}},"ko":{"stringUnit":{"state":"translated","value":"허용 시 ScaleMe가 체중과 기록된 체지방을 Apple 건강에 저장합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Com a sua permissão, o ScaleMe escreve o peso e a gordura registada na Saúde Apple."}},"ru":{"stringUnit":{"state":"translated","value":"С вашего разрешения ScaleMe записывает вес и явно указанный процент жира в Apple Здоровье."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"观我仅在您同意后，将体重和明确记录的体脂率写入 Apple 健康。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"觀我僅在您同意後，將體重和明確記錄的體脂率寫入 Apple 健康。"}}}}
  },
  "version" : "1.0"
}
