    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "观我需要蓝牙来发现并读取您主动使用的体重体脂秤。"
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription" : {
      "comment" : "Privacy - Bluetooth Peripheral Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "观我需要蓝牙连接体重体脂秤。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScaleMe schreibt mit Ihrer Zustimmung Gewicht und erfassten Körperfettanteil in Apple Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your permission, ScaleMe writes weight and recorded body fat to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu permiso, ScaleMe escribe el peso y la grasa registrada en Apple Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec votre autorisation, ScaleMe écrit le poids et la graisse enregistrée dans Apple Santé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可された場合、ScaleMeは体重と記録した体脂肪をAppleヘルスケアに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용 시 ScaleMe가 체중과 기록된 체지방을 Apple 건강에 저장합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a sua permissão, o ScaleMe escreve o peso e a gordura registada na Saúde Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С вашего разрешения ScaleMe записывает вес и явно указанный процент жира в Apple Здоровье."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观我仅在您同意后，将体重和明确记录的体脂率写入 Apple 健康。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觀我僅在您同意後，將體重和明確記錄的體脂率寫入 Apple 健康。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
