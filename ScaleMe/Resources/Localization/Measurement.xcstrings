{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "BMI、脂肪量、肌肉占比、水分量、骨量占比和蛋白质等指标，将根据测量值与当前成员 %@ 的身体资料自动计算。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI, Fett, Muskeln, Wasser und weitere Werte werden aus Messung und Profil von %@ berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI, fat, muscle, water, and other values use %@'s measurement and profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC, la grasa, los músculos y otros valores usan la medición y el perfil de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC, la masse grasse et d’autres valeurs utilisent la mesure et le profil de %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI、脂肪、筋肉、水分などは %@ の測定値とプロフィールから計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI, 지방, 근육, 수분 등은 %@의 측정값과 프로필로 계산합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IMC, a gordura e outros valores usam a medição e o perfil de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИМТ, жир, мышцы и другие показатели рассчитываются по измерению и профилю %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI、脂肪量、肌肉占比、水分量、骨量占比和蛋白质等指标，将根据测量值与当前成员 %@ 的身体资料自动计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI、脂肪量、肌肉比例、水分量、骨量比例和蛋白質等指標，將根據測量值與目前成員 %@ 的身體資料自動計算。"
          }
        }
      }
