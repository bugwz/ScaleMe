    "轻踩唤醒体重秤后站稳，本应用会自动接收读数" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wecke die Waage auf und bleibe ruhig stehen. Die App empfängt den Messwert automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wake the scale, then stand still. The app will receive the reading automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la báscula y quédate quieto. La app recibirá la lectura automáticamente."
