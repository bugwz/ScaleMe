    "记录成员，当前为 %@，%@" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"en":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"es":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"fr":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"ja":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"ko":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"pt":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"ru":{"stringUnit":{"state":"translated","value":"Record member. Current: %@, %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录成员，当前为 %1$@，%2$@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"记录成员，当前为 %@，%@"}}}},
