    "点击展开选择记录成员" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"en":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"es":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"fr":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"ja":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"ko":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"pt":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"ru":{"stringUnit":{"state":"translated","value":"Expand to choose the record member"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点击展开选择记录成员"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"点击展开选择记录成员"}}}},
    "点击选择本次测量使用的体重秤或体脂秤" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Tippen, um die Waage für diese Messung auszuwählen"}},"en":{"stringUnit":{"state":"translated","value":"Choose the scale to use for this measurement"}},"es":{"stringUnit":{"state":"translated","value":"Elegir la báscula para esta medición"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir la balance pour cette mesure"}},"ja":{"stringUnit":{"state":"translated","value":"今回の測定に使う体重計を選択"}},"ko":{"stringUnit":{"state":"translated","value":"이번 측정에 사용할 체중계 선택"}},"pt":{"stringUnit":{"state":"translated","value":"Escolher a balança para esta medição"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать весы для этого измерения"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点击选择本次测量使用的体重秤或体脂秤"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"點擊選擇本次測量使用的體重計或體脂計"}}}},
