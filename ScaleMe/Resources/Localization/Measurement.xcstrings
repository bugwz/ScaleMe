{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "未保存" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht gespeichert"}},"en":{"stringUnit":{"state":"translated","value":"Not saved"}},"es":{"stringUnit":{"state":"translated","value":"Sin guardar"}},"fr":{"stringUnit":{"state":"translated","value":"Non enregistré"}},"ja":{"stringUnit":{"state":"translated","value":"未保存"}},"ko":{"stringUnit":{"state":"translated","value":"저장되지 않음"}},"pt":{"stringUnit":{"state":"translated","value":"Não salvo"}},"ru":{"stringUnit":{"state":"translated","value":"Не сохранено"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未保存"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未儲存"}}}},
    "重试保存" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut speichern"}},"en":{"stringUnit":{"state":"translated","value":"Retry saving"}},"es":{"stringUnit":{"state":"translated","value":"Reintentar guardado"}},"fr":{"stringUnit":{"state":"translated","value":"Réessayer l’enregistrement"}},"ja":{"stringUnit":{"state":"translated","value":"保存を再試行"}},"ko":{"stringUnit":{"state":"translated","value":"저장 다시 시도"}},"pt":{"stringUnit":{"state":"translated","value":"Tentar salvar novamente"}},"ru":{"stringUnit":{"state":"translated","value":"Повторить сохранение"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试保存"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重試儲存"}}}},
    "保存失败，数据尚未写入本机。请重试；退出应用后未保存的数据可能丢失。" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Speichern fehlgeschlagen. Die Daten wurden nicht auf diesem Gerät gespeichert. Bitte erneut versuchen; beim Beenden der App können ungespeicherte Daten verloren gehen."}},"en":{"stringUnit":{"state":"translated","value":"Saving failed. The data has not been saved on this device. Please retry; unsaved data may be lost if you quit the app."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar. Los datos no se han guardado en este dispositivo. Reinténtalo; los datos sin guardar pueden perderse al salir de la app."}},"fr":{"stringUnit":{"state":"translated","value":"Échec de l’enregistrement. Les données ne sont pas enregistrées sur cet appareil. Réessayez ; les données non enregistrées peuvent être perdues en quittant l’app."}},"ja":{"stringUnit":{"state":"translated","value":"保存に失敗しました。データはこの端末に保存されていません。再試行してください。アプリを終了すると未保存のデータが失われる可能性があります。"}},"ko":{"stringUnit":{"state":"translated","value":"저장하지 못했습니다. 데이터가 이 기기에 저장되지 않았습니다. 다시 시도하세요. 앱을 종료하면 저장되지 않은 데이터가 사라질 수 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Falha ao salvar. Os dados não foram salvos neste dispositivo. Tente novamente; dados não salvos podem ser perdidos ao sair do app."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить данные на этом устройстве. Повторите попытку: при выходе из приложения несохранённые данные могут быть потеряны."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存失败，数据尚未写入本机。请重试；退出应用后未保存的数据可能丢失。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存失敗，資料尚未寫入本機。請重試；結束應用程式後未儲存的資料可能遺失。"}}}},
    "BMI、脂肪量、肌肉占比、水分量、骨量占比和蛋白质等指标，将根据测量值与当前成员 %@ 的身体资料自动计算。" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"BMI, Fett, Muskeln, Wasser und weitere Werte werden aus Messung und Profil von %@ berechnet."}},"en":{"stringUnit":{"state":"translated","value":"BMI, fat, muscle, water, and other values use %@'s measurement and profile."}},"es":{"stringUnit":{"state":"translated","value":"El IMC, la grasa, los músculos y otros valores usan la medición y el perfil de %@."}},"fr":{"stringUnit":{"state":"translated","value":"L’IMC, la masse grasse et d’autres valeurs utilisent la mesure et le profil de %@."}},"ja":{"stringUnit":{"state":"translated","value":"BMI、脂肪、筋肉、水分などは %@ の測定値とプロフィールから計算します。"}},"ko":{"stringUnit":{"state":"translated","value":"BMI, 지방, 근육, 수분 등은 %@의 측정값과 프로필로 계산합니다."}},"pt":{"stringUnit":{"state":"translated","value":"O IMC, a gordura e outros valores usam a medição e o perfil de %@."}},"ru":{"stringUnit":{"state":"translated","value":"ИМТ, жир, мышцы и другие показатели рассчитываются по измерению и профилю %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"BMI、脂肪量、肌肉占比、水分量、骨量占比和蛋白质等指标，将根据测量值与当前成员 %@ 的身体资料自动计算。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"BMI、脂肪量、肌肉比例、水分量、骨量比例和蛋白質等指標，將根據測量值與目前成員 %@ 的身體資料自動計算。"}}}},
    "切换测量成员，当前为 %@" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"en":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"es":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"ja":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"ko":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"pt":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Switch measurement member. Current: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"切换测量成员，当前为 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"切换测量成员，当前为 %@"}}}},
    "切换测量设备，当前为 %@" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Messgerät wechseln, aktuell %@"}},"en":{"stringUnit":{"state":"translated","value":"Switch measurement device, currently %@"}},"es":{"stringUnit":{"state":"translated","value":"Cambiar dispositivo de medición, actual: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Changer d’appareil de mesure, actuellement %@"}},"ja":{"stringUnit":{"state":"translated","value":"測定デバイスを切り替え、現在は%@"}},"ko":{"stringUnit":{"state":"translated","value":"측정 기기 전환, 현재 %@"}},"pt":{"stringUnit":{"state":"translated","value":"Alterar dispositivo de medição, atual: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Сменить устройство измерения, сейчас %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"切换测量设备，当前为 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"切換測量裝置，目前為 %@"}}}},
    "可选，50 ~ 2000" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"en":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"es":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"fr":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"ja":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"ko":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"pt":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"ru":{"stringUnit":{"state":"translated","value":"Optional, 50–2000"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选，50 ~ 2000"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可选，50 ~ 2000"}}}},
    "基础测量" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Grundmessung"}},"en":{"stringUnit":{"state":"translated","value":"Basic measurement"}},"es":{"stringUnit":{"state":"translated","value":"Medición básica"}},"fr":{"stringUnit":{"state":"translated","value":"Mesure de base"}},"ja":{"stringUnit":{"state":"translated","value":"基本測定"}},"ko":{"stringUnit":{"state":"translated","value":"기본 측정"}},"pt":{"stringUnit":{"state":"translated","value":"Medição básica"}},"ru":{"stringUnit":{"state":"translated","value":"Основное измерение"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"基础测量"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"基本測量"}}}},
    "已完成" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Fertig"}},"en":{"stringUnit":{"state":"translated","value":"Complete"}},"es":{"stringUnit":{"state":"translated","value":"Completado"}},"fr":{"stringUnit":{"state":"translated","value":"Terminé"}},"ja":{"stringUnit":{"state":"translated","value":"完了"}},"ko":{"stringUnit":{"state":"translated","value":"완료"}},"pt":{"stringUnit":{"state":"translated","value":"Concluído"}},"ru":{"stringUnit":{"state":"translated","value":"Готово"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成"}}}},
    "当前为模拟数据模式，本次记录仅在本次运行中保留。" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Demodatenmodus ist aktiv. Dieser Eintrag bleibt nur während der aktuellen App-Sitzung erhalten."}},"en":{"stringUnit":{"state":"translated","value":"Demo data mode is active. This entry is kept only for the current app session."}},"es":{"stringUnit":{"state":"translated","value":"El modo de datos de demostración está activo. Este registro solo se conserva durante la sesión actual."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode données de démonstration est actif. Cette mesure n’est conservée que pendant la session actuelle."}},"ja":{"stringUnit":{"state":"translated","value":"シミュレーションデータモードです。この記録は現在のアプリ実行中だけ保持されます。"}},"ko":{"stringUnit":{"state":"translated","value":"데모 데이터 모드입니다. 이 기록은 현재 앱 실행 중에만 유지됩니다."}},"pt":{"stringUnit":{"state":"translated","value":"O modo de dados de demonstração está ativo. Este registo é mantido apenas durante a sessão atual."}},"ru":{"stringUnit":{"state":"translated","value":"Включён режим демонстрационных данных. Эта запись сохраняется только в текущем сеансе."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前为模拟数据模式，本次记录仅在本次运行中保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前為模擬資料模式，本次記錄僅在本次執行期間保留。"}}}},
    "必填，5.00 ~ 350.00" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"en":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"es":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"fr":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"ja":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"ko":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"pt":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"ru":{"stringUnit":{"state":"translated","value":"Required, 5.00–350.00"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"必填，5.00 ~ 350.00"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"必填，5.00 ~ 350.00"}}}},
    "手动记录仅保存在本机，并会清晰标记为“手动记录”来源。" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"en":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"es":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"fr":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"ja":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"ko":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"pt":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"ru":{"stringUnit":{"state":"translated","value":"Manual entries stay on this device and are clearly marked as “Manual entry”."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"手动记录仅保存在本机，并会清晰标记为“手动记录”来源。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手动记录仅保存在本机，并会清晰标记为“手动记录”来源。"}}}},
