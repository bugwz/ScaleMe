    "外部规则只能使用声明式 decoder" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "External rules may use only the declarative decoder"
          }
        },
        "en" : {
