    "仅共享设备或手动记录明确提供的数值" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ausdrücklich vom Gerät oder manuell erfasste Werte"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only values explicitly provided by the device or manual entry"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo valores proporcionados explícitamente por el dispositivo o una entrada manual"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement les valeurs explicitement fournies par l’appareil ou saisies manuellement"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスまたは手動入力で明示された値のみ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 또는 수동 기록에서 명시적으로 제공된 값만"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas valores explicitamente fornecidos pelo dispositivo ou introduzidos manualmente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только значения, явно предоставленные устройством или введенные вручную"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅共享设备或手动记录明确提供的数值"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅共享裝置或手動記錄明確提供的數值"
          }
        }
      }
    },
    "体脂及相关指标是基于生物电阻抗和个人资料的消费级估算值，仅用于日常趋势参考，不构成医疗诊断。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körperfett und verwandte Werte sind Schätzungen für Alltagstrends, keine Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body fat and related values are estimates for everyday trends, not a diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grasa corporal y otros valores son estimaciones para observar tendencias, no un diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La masse grasse et les valeurs associées sont des estimations de tendance, pas un diagnostic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体脂肪などは傾向を見るための推定値で、医療診断ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체지방 등은 추세 확인용 추정치이며 의료 진단이 아닙니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gordura corporal e outros valores são estimativas de tendência, não um diagnóstico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жировая масса и другие показатели — оценки для отслеживания тенденций, не диагноз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体脂及相关指标是基于生物电阻抗和个人资料的消费级估算值，仅用于日常趋势参考，不构成医疗诊断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "體脂及相關指標是基於生物電阻抗和個人資料的消費級估算值，僅用於日常趨勢參考，不構成醫療診斷。"
          }
        }
      }
    },
    "体脂等身体成分为消费级估算，仅用于观察长期趋势。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
