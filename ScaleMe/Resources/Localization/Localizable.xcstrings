        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senssun IF2121A의 33CC 실시간 체중, 안정 상태, 감지 단계 및 40바이트 분할 최종 결과를 해석하며, 확인되지 않은 체성분 필드는 저장하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa o peso em tempo real, a estabilidade, as fases de deteção e o resultado final fragmentado de 40 bytes do Senssun IF2121A através de 33CC; os campos de composição corporal não confirmados não são guardados."
          }
        },
        "ru" : {
          "stringUnit" : {
