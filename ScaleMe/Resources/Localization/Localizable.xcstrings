    "--" : {

    },
    "“内置”表示解析器已实现；具体设备是否可用仍以实机、固件和已捕获数据验证为准。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Integriert“ heißt: Parser vorhanden. Kompatibilität muss mit Gerätedaten und echter Hardware geprüft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in means the parser is ready. Hardware compatibility still needs device testing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrado significa que el analizador está listo. La compatibilidad requiere probar el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégré signifie que l’analyseur est prêt. La compatibilité doit être testée sur l’appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵は解析器が利用できる状態です。互換性は実機で確認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장은 파서가 준비된 상태입니다. 호환성은 실제 기기에서 확인해야 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrado indica que o analisador está pronto. A compatibilidade requer testes no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенный означает, что анализатор готов. Совместимость нужно проверить на устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“内置”表示解析器已实现；具体设备是否可用仍以实机、固件和已捕获数据验证为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“内置”表示解析器已实现；具体设备是否可用仍以实机、固件和已捕获数据验证为准。"
          }
        }
      }
