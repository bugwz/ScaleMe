{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "手机记录已更新，请刷新后重试": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机记录已更新，请刷新后重试"}},"en":{"stringUnit":{"state":"translated","value":"Phone records changed. Refresh and try again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機記錄已更新，請重新整理後再試"}},"de":{"stringUnit":{"state":"translated","value":"Die iPhone-Daten wurden geändert. Aktualisiere sie und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Los registros del iPhone cambiaron. Actualiza e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Les données de l’iPhone ont changé. Actualisez puis réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneの記録が更新されました。更新して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 기록이 변경되었습니다. 새로고침 후 다시 시도하세요."}},"pt":{"stringUnit":{"state":"translated","value":"Os registros do iPhone mudaram. Atualize e tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Записи на iPhone изменились. Обновите и повторите попытку."}}}},
    "手机暂不可达，请打开手机上的观我": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机暂不可达，请打开手机上的观我"}},"en":{"stringUnit":{"state":"translated","value":"iPhone unavailable. Open ScaleMe on your iPhone."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機暫時無法連線，請開啟手機上的觀我"}},"de":{"stringUnit":{"state":"translated","value":"iPhone nicht erreichbar. Öffne ScaleMe auf deinem iPhone."}},"es":{"stringUnit":{"state":"translated","value":"iPhone no disponible. Abre ScaleMe en el iPhone."}},"fr":{"stringUnit":{"state":"translated","value":"iPhone indisponible. Ouvrez ScaleMe sur votre iPhone."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneに接続できません。iPhoneでScaleMeを開いてください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에 연결할 수 없습니다. iPhone에서 ScaleMe를 여세요."}},"pt":{"stringUnit":{"state":"translated","value":"iPhone indisponível. Abra o ScaleMe no iPhone."}},"ru":{"stringUnit":{"state":"translated","value":"iPhone недоступен. Откройте ScaleMe на iPhone."}}}},
    "请求未确认，请刷新手机状态": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请求未确认，请刷新手机状态"}},"en":{"stringUnit":{"state":"translated","value":"No response received. Refresh to check the iPhone."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請求未確認，請重新整理手機狀態"}},"de":{"stringUnit":{"state":"translated","value":"Keine Antwort erhalten. Aktualisiere den iPhone-Status."}},"es":{"stringUnit":{"state":"translated","value":"No se recibió respuesta. Actualiza el estado del iPhone."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune réponse reçue. Actualisez l’état de l’iPhone."}},"ja":{"stringUnit":{"state":"translated","value":"応答がありません。iPhoneの状態を更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"응답이 없습니다. iPhone 상태를 새로고침하세요."}},"pt":{"stringUnit":{"state":"translated","value":"Nenhuma resposta recebida. Atualize o estado do iPhone."}},"ru":{"stringUnit":{"state":"translated","value":"Ответ не получен. Обновите состояние iPhone."}}}},
    "手机暂不可达，当前显示上次同步记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机暂不可达，当前显示上次同步记录"}},"en":{"stringUnit":{"state":"translated","value":"iPhone unavailable. Showing last synced records."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機暫時無法連線，目前顯示上次同步記錄"}},"de":{"stringUnit":{"state":"translated","value":"iPhone nicht erreichbar. Zuletzt synchronisierte Daten werden angezeigt."}},"es":{"stringUnit":{"state":"translated","value":"iPhone no disponible. Se muestran los últimos registros sincronizados."}},"fr":{"stringUnit":{"state":"translated","value":"iPhone indisponible. Affichage des dernières données synchronisées."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneに接続できません。前回同期した記録を表示しています。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에 연결할 수 없습니다. 마지막으로 동기화한 기록을 표시합니다."}},"pt":{"stringUnit":{"state":"translated","value":"iPhone indisponível. Exibindo os últimos registros sincronizados."}},"ru":{"stringUnit":{"state":"translated","value":"iPhone недоступен. Показаны последние синхронизированные записи."}}}},
    "刷新手机记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新手机记录"}},"en":{"stringUnit":{"state":"translated","value":"Refresh iPhone records"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新整理手機記錄"}},"de":{"stringUnit":{"state":"translated","value":"iPhone-Daten aktualisieren"}},"es":{"stringUnit":{"state":"translated","value":"Actualizar registros del iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Actualiser les données de l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneの記録を更新"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 기록 새로고침"}},"pt":{"stringUnit":{"state":"translated","value":"Atualizar registros do iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Обновить записи iPhone"}}}},
    "正在同步手机记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"正在同步手机记录"}},"en":{"stringUnit":{"state":"translated","value":"Syncing iPhone records"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在同步手機記錄"}},"de":{"stringUnit":{"state":"translated","value":"iPhone-Daten werden synchronisiert"}},"es":{"stringUnit":{"state":"translated","value":"Sincronizando registros del iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Synchronisation des données de l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneの記録を同期中"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 기록 동기화 중"}},"pt":{"stringUnit":{"state":"translated","value":"Sincronizando registros do iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация записей iPhone"}}}},
    "手机数据更新时间": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机数据更新时间"}},"en":{"stringUnit":{"state":"translated","value":"Last iPhone update"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機資料更新時間"}},"de":{"stringUnit":{"state":"translated","value":"Letzte iPhone-Aktualisierung"}},"es":{"stringUnit":{"state":"translated","value":"Última actualización del iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Dernière mise à jour de l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneデータの更新日時"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 데이터 업데이트 시간"}},"pt":{"stringUnit":{"state":"translated","value":"Última atualização do iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Обновление данных iPhone"}}}},
    "手机测试数据": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机测试数据"}},"en":{"stringUnit":{"state":"translated","value":"iPhone demo data"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機測試資料"}},"de":{"stringUnit":{"state":"translated","value":"iPhone-Demodaten"}},"es":{"stringUnit":{"state":"translated","value":"Datos de prueba del iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Données de démonstration de l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneのデモデータ"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 테스트 데이터"}},"pt":{"stringUnit":{"state":"translated","value":"Dados de demonstração do iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Тестовые данные iPhone"}}}},
    "手机暂无测量记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机暂无测量记录"}},"en":{"stringUnit":{"state":"translated","value":"No measurements on iPhone"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機暫無測量記錄"}},"de":{"stringUnit":{"state":"translated","value":"Keine Messungen auf dem iPhone"}},"es":{"stringUnit":{"state":"translated","value":"No hay mediciones en el iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune mesure sur l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneに測定記録がありません"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에 측정 기록이 없습니다"}},"pt":{"stringUnit":{"state":"translated","value":"Nenhuma medição no iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"На iPhone пока нет измерений"}}}},
    "查看手机测量记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"查看手机测量记录"}},"en":{"stringUnit":{"state":"translated","value":"iPhone measurements"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看手機測量記錄"}},"de":{"stringUnit":{"state":"translated","value":"iPhone-Messungen"}},"es":{"stringUnit":{"state":"translated","value":"Mediciones del iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Mesures de l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneの測定記録"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 측정 기록"}},"pt":{"stringUnit":{"state":"translated","value":"Medições do iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Измерения на iPhone"}}}},
    "跟随手机当前成员，仅查看手机记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"跟随手机当前成员，仅查看手机记录"}},"en":{"stringUnit":{"state":"translated","value":"View-only records for the member selected on iPhone."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"跟隨手機目前成員，僅查看手機記錄"}},"de":{"stringUnit":{"state":"translated","value":"Schreibgeschützte Daten des auf dem iPhone ausgewählten Mitglieds."}},"es":{"stringUnit":{"state":"translated","value":"Registros de solo lectura del miembro seleccionado en el iPhone."}},"fr":{"stringUnit":{"state":"translated","value":"Données en lecture seule du membre sélectionné sur l’iPhone."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneで選択中のメンバーの記録を閲覧できます。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 선택한 멤버의 기록을 읽기 전용으로 표시합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Registros somente para leitura do membro selecionado no iPhone."}},"ru":{"stringUnit":{"state":"translated","value":"Записи выбранного на iPhone участника, только для просмотра."}}}},
    "打开手机上的观我以同步记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"打开手机上的观我以同步记录"}},"en":{"stringUnit":{"state":"translated","value":"Open ScaleMe on iPhone to sync records."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟手機上的觀我以同步記錄"}},"de":{"stringUnit":{"state":"translated","value":"Öffne ScaleMe auf dem iPhone, um Daten zu synchronisieren."}},"es":{"stringUnit":{"state":"translated","value":"Abre ScaleMe en el iPhone para sincronizar registros."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez ScaleMe sur l’iPhone pour synchroniser les données."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneでScaleMeを開いて記録を同期してください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone에서 ScaleMe를 열어 기록을 동기화하세요."}},"pt":{"stringUnit":{"state":"translated","value":"Abra o ScaleMe no iPhone para sincronizar os registros."}},"ru":{"stringUnit":{"state":"translated","value":"Откройте ScaleMe на iPhone для синхронизации записей."}}}},
    "加载更早的手机记录": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"加载更早的手机记录"}},"en":{"stringUnit":{"state":"translated","value":"Load earlier iPhone records"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"載入更早的手機記錄"}},"de":{"stringUnit":{"state":"translated","value":"Ältere iPhone-Daten laden"}},"es":{"stringUnit":{"state":"translated","value":"Cargar registros anteriores del iPhone"}},"fr":{"stringUnit":{"state":"translated","value":"Charger les anciennes données de l’iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneの過去の記録を読み込む"}},"ko":{"stringUnit":{"state":"translated","value":"이전 iPhone 기록 불러오기"}},"pt":{"stringUnit":{"state":"translated","value":"Carregar registros anteriores do iPhone"}},"ru":{"stringUnit":{"state":"translated","value":"Загрузить более ранние записи iPhone"}}}},
    "身体成分为估算值，仅供趋势参考": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"身体成分为估算值，仅供趋势参考"}},"en":{"stringUnit":{"state":"translated","value":"Body composition is estimated, for trend reference only."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體組成為估算值，僅供趨勢參考"}},"de":{"stringUnit":{"state":"translated","value":"Die Körperzusammensetzung ist geschätzt und dient nur zur Trendbeobachtung."}},"es":{"stringUnit":{"state":"translated","value":"La composición corporal es estimada y solo sirve como referencia de tendencias."}},"fr":{"stringUnit":{"state":"translated","value":"La composition corporelle est estimée, uniquement pour suivre les tendances."}},"ja":{"stringUnit":{"state":"translated","value":"体組成は推定値であり、傾向の参考としてのみご利用ください。"}},"ko":{"stringUnit":{"state":"translated","value":"체성분은 추정치이며 추세 참고용입니다."}},"pt":{"stringUnit":{"state":"translated","value":"A composição corporal é estimada, apenas para referência de tendências."}},"ru":{"stringUnit":{"state":"translated","value":"Состав тела — оценочные данные, только для наблюдения за динамикой."}}}},
    "手机记录已更新，请返回记录列表": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"手机记录已更新，请返回记录列表"}},"en":{"stringUnit":{"state":"translated","value":"iPhone records changed. Return to the records list."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手機記錄已更新，請返回記錄列表"}},"de":{"stringUnit":{"state":"translated","value":"Die iPhone-Daten wurden geändert. Kehre zur Liste zurück."}},"es":{"stringUnit":{"state":"translated","value":"Los registros del iPhone cambiaron. Vuelve a la lista."}},"fr":{"stringUnit":{"state":"translated","value":"Les données de l’iPhone ont changé. Revenez à la liste."}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneの記録が更新されました。記録一覧に戻ってください。"}},"ko":{"stringUnit":{"state":"translated","value":"iPhone 기록이 변경되었습니다. 기록 목록으로 돌아가세요."}},"pt":{"stringUnit":{"state":"translated","value":"Os registros do iPhone mudaram. Volte à lista."}},"ru":{"stringUnit":{"state":"translated","value":"Записи на iPhone изменились. Вернитесь к списку."}}}},
    "安装手表应用后，当前成员名称、设备名称和测量记录会同步到配对的 Apple Watch，仅供查看。完整记录保存在手机；手表可保留上次同步快照，删除或修改会在下次同步后生效。": {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"安装手表应用后，当前成员名称、设备名称和测量记录会同步到配对的 Apple Watch，仅供查看。完整记录保存在手机；手表可保留上次同步快照，删除或修改会在下次同步后生效。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝手錶應用程式後，目前成員名稱、裝置名稱和測量記錄會同步到配對的 Apple Watch，僅供查看。完整記錄儲存在手機；手錶可保留上次同步快照，刪除或修改會在下次同步後生效。"}},"en":{"stringUnit":{"state":"translated","value":"After installing the watch app, the current member name, device names and measurements sync to the paired Apple Watch for viewing only. Full records stay on iPhone. The watch may retain the last synced snapshot; deletions and changes take effect after the next sync."}},"de":{"stringUnit":{"state":"translated","value":"Nach der Installation der Watch-App werden der aktuelle Mitgliedsname, Gerätenamen und Messungen nur zur Ansicht mit der gekoppelten Apple Watch synchronisiert. Vollständige Daten bleiben auf dem iPhone. Die Watch kann den letzten Datenstand behalten; Löschungen und Änderungen werden bei der nächsten Synchronisierung übernommen."}},"es":{"stringUnit":{"state":"translated","value":"Tras instalar la app del reloj, el nombre del miembro actual, los nombres de dispositivos y las mediciones se sincronizan con el Apple Watch enlazado solo para consulta. Los registros completos permanecen en el iPhone. El reloj puede conservar la última copia sincronizada; las eliminaciones y los cambios se aplican en la siguiente sincronización."}},"fr":{"stringUnit":{"state":"translated","value":"Après l’installation de l’app sur la montre, le nom du membre actuel, les noms des appareils et les mesures sont synchronisés avec l’Apple Watch jumelée, en lecture seule. Les données complètes restent sur l’iPhone. La montre peut conserver la dernière copie synchronisée ; les suppressions et modifications sont appliquées à la prochaine synchronisation."}},"ja":{"stringUnit":{"state":"translated","value":"Watchアプリをインストールすると、現在のメンバー名、デバイス名、測定記録がペアリング済みのApple Watchに閲覧専用で同期されます。完全な記録はiPhoneに保存されます。Watchには前回同期したデータが残る場合があり、削除や変更は次回の同期後に反映されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Watch 앱을 설치하면 현재 멤버 이름, 기기 이름 및 측정 기록이 페어링된 Apple Watch에 읽기 전용으로 동기화됩니다. 전체 기록은 iPhone에 저장됩니다. Watch에는 마지막 동기화 데이터가 남을 수 있으며 삭제 및 변경은 다음 동기화 후 반영됩니다."}},"pt":{"stringUnit":{"state":"translated","value":"Após instalar o app do relógio, o nome do membro atual, os nomes dos dispositivos e as medições são sincronizados com o Apple Watch emparelhado apenas para consulta. Os registros completos ficam no iPhone. O relógio pode manter a última cópia sincronizada; exclusões e alterações entram em vigor na próxima sincronização."}},"ru":{"stringUnit":{"state":"translated","value":"После установки приложения на часы имя текущего участника, названия устройств и измерения синхронизируются с сопряжёнными Apple Watch только для просмотра. Полные записи остаются на iPhone. Часы могут хранить последнюю синхронизированную копию; удаления и изменения применяются при следующей синхронизации."}}}}
  },
  "version" : "1.0"
}
